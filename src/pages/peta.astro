---
import Layout from '../layouts/Layout.astro';
import MapSection from '../components/MapSection.astro';
import DetailModal from '../components/DetailModal.astro';
---

<Layout title="Peta Interaktif SPPG Bandung Raya | SIGMA-B">
  <main id="main-content" tabindex="-1" class="relative w-full h-dvh overflow-hidden focus:outline-none">
    <MapSection />
  </main>

  <DetailModal />
</Layout>

<script>
  import { sppgList, type SPPG } from '../data/sppg';
  import { incidentList, incidentsEnabled, type Incident } from '../data/incidents';
  import { initDropdowns } from '../scripts/dropdown';
  import { statusInfo, shortWilayah, mapsUrl, escapeHtml, formatCoord } from '../data/summary';

  // Kunci titik = candidateId (stabil, tidak bergantung urutan CSV).
  type MarkerEntry = { id: string; marker: any; sppg: SPPG };

  let currentMap: any = null;
  let markersLayer: any = null;
  const allMarkers = new Map<string, MarkerEntry>();
  let markerById = new Map<string, MarkerEntry>(); // hanya yang sedang tampil (lolos filter)
  let filtered: SPPG[] = sppgList;
  let listLimit = 0;

  const BANDUNG_CENTER = [-6.9175, 107.6191];
  const LIST_PAGE = 40;
  const FILTER_SELECTS = ['map-select-wilayah', 'map-select-status', 'map-select-incident'];
  const byId = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const incidentsFor = (id: string): Incident[] => (incidentsEnabled ? incidentList.filter(i => i.candidateId === id) : []);
  const isDesktop = window.matchMedia('(min-width: 1024px)');

  document.addEventListener('DOMContentLoaded', () => {
    initDropdowns();
    initPanel();
    initFilters();
    initLeafletMap();
    initModalHandlers();
  });

  // 1. Panel samping
  let panelWanted = false; // keadaan yang diminta pengguna (bisa beda dengan data-open selama animasi)
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const EASE_OUT = 'cubic-bezier(0.16, 1, 0.3, 1)';
  // Sedikit melewati target lalu kembali: panel terasa "memantul" saat terbuka.
  const EASE_SPRING = 'cubic-bezier(0.34, 1.32, 0.5, 1)';

  // Isi panel yang dianimasikan berurutan: blok cari+filter, judul daftar, ~8 baris pertama.
  function panelPieces(): HTMLElement[] {
    const body = byId('map-panel-body');
    if (!body) return [];
    const blocks = [...body.children].filter(el => !el.classList.contains('map-panel-list')) as HTMLElement[];
    const rows = [...body.querySelectorAll<HTMLElement>('#map-point-list > li')].slice(0, 8);
    return [...blocks, ...rows];
  }

  // Buka/tutup dengan animasi tinggi (FLIP: ukur sebelum dan sesudah, lalu animasikan selisihnya)
  // dan isi yang masuk berurutan. Tanpa animasi saat awal muat dan saat reduced motion.
  function animatePanel(panel: HTMLElement, open: boolean, apply: () => void) {
    panel.getAnimations().forEach(a => a.cancel());
    panelPieces().forEach(el => el.getAnimations().forEach(a => a.cancel()));

    const morph = (from: number) => {
      const to = panel.offsetHeight;
      panel.style.overflow = 'hidden';
      const anim = panel.animate(
        [{ height: `${from}px` }, { height: `${to}px` }],
        { duration: open ? 520 : 320, easing: open ? EASE_SPRING : EASE_OUT },
      );
      anim.onfinish = anim.oncancel = () => { panel.style.overflow = ''; };
    };

    if (open) {
      const from = panel.offsetHeight;
      apply();
      morph(from);
      panelPieces().forEach((el, i) => {
        el.animate(
          [
            { opacity: 0, transform: 'translateY(-10px)', filter: 'blur(4px)' },
            { opacity: 1, transform: 'none', filter: 'none' },
          ],
          { duration: 420, delay: 90 + i * 35, easing: EASE_OUT, fill: 'backwards' },
        );
      });
    } else {
      const pieces = panelPieces();
      const fades = pieces.map(el =>
        el.animate([{ opacity: 1 }, { opacity: 0, transform: 'translateY(-6px)' }], { duration: 140, easing: 'ease-in', fill: 'forwards' }),
      );
      const done = () => {
        // Diklik lagi selama memudar: batalkan penutupan, isi kembali terlihat.
        if (panelWanted !== open) {
          fades.forEach(f => f.cancel());
          return;
        }
        const from = panel.offsetHeight;
        apply();
        fades.forEach(f => f.cancel());
        morph(from);
      };
      if (fades.length) fades[0].finished.then(done, () => {});
      else done();
    }
  }

  function setPanel(open: boolean, animate = false) {
    const panel = byId('map-panel');
    const toggle = byId('map-panel-toggle');
    if (!panel || !toggle) return;
    const apply = () => {
      panel.dataset.open = String(open);
      updatePopupPadding();
    };
    if (animate && !reduceMotion.matches && panel.dataset.open !== String(open)) animatePanel(panel, open, apply);
    else {
      panel.getAnimations().forEach(a => a.cancel());
      apply();
    }
    toggle.setAttribute('aria-expanded', String(open));
    const label = byId('map-panel-toggle-label');
    if (label) label.textContent = open ? 'Tutup panel' : 'Cari & filter';
  }

  // Popup memakai padding auto-pan dari posisi panel saat ini.
  function updatePopupPadding() {
    const pad = autoPanTopLeft();
    allMarkers.forEach(m => {
      const popup = m.marker.getPopup();
      if (popup) popup.options.autoPanPaddingTopLeft = pad;
    });
  }

  function initPanel() {
    panelWanted = isDesktop.matches;
    setPanel(panelWanted);
    isDesktop.addEventListener('change', () => {
      panelWanted = isDesktop.matches;
      setPanel(panelWanted);
    });
    byId('map-panel-toggle')?.addEventListener('click', () => {
      panelWanted = !panelWanted;
      setPanel(panelWanted, true);
    });
  }

  // 2. Filter (pencarian + select) berlaku untuk penanda dan daftar sekaligus
  function initFilters() {
    const search = byId<HTMLInputElement>('map-search-input');
    // Ditunda 150 ms: saat mengetik cepat, peta dan daftar cukup diperbarui sekali di akhir.
    let searchTimer: ReturnType<typeof setTimeout> | undefined;
    search?.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => applyFilters(false), 150);
    });
    search?.addEventListener('keydown', e => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      clearTimeout(searchTimer);
      applyFilters(false);
      byId('map-point-list')?.querySelector<HTMLElement>('.map-point')?.click();
    });
    FILTER_SELECTS.forEach(id => byId(id)?.addEventListener('change', () => applyFilters(true)));

    byId('map-filter-reset')?.addEventListener('click', resetFilters);
    byId('map-empty-reset')?.addEventListener('click', resetFilters);
    byId('map-list-more-btn')?.addEventListener('click', () => renderList(true));

    byId('map-point-list')?.addEventListener('click', e => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.map-point');
      if (btn?.dataset.id) focusMarker(btn.dataset.id);
    });

    // Tautan dari landing page: /peta?wilayah=Kota%20Bandung
    const wilayahParam = new URLSearchParams(location.search).get('wilayah');
    const wilayahSel = byId<HTMLSelectElement>('map-select-wilayah');
    if (wilayahParam && wilayahSel && [...wilayahSel.options].some(o => o.value === wilayahParam)) {
      wilayahSel.value = wilayahParam;
    }
    applyFilters(false);
  }

  function resetFilters() {
    const search = byId<HTMLInputElement>('map-search-input');
    if (search) search.value = '';
    FILTER_SELECTS.forEach(id => {
      const el = byId<HTMLSelectElement>(id);
      if (el) el.value = 'all';
    });
    applyFilters(true);
  }

  function applyFilters(fit: boolean) {
    const q = byId<HTMLInputElement>('map-search-input')?.value.toLowerCase().trim() || '';
    const [wilayahVal, statusVal, incidentVal] = FILTER_SELECTS.map(id => byId<HTMLSelectElement>(id)?.value || 'all');

    filtered = sppgList.filter(s => {
      if (q && !`${s.nama} ${s.kecamatan} ${s.alamat} ${s.wilayah}`.toLowerCase().includes(q)) return false;
      if (wilayahVal !== 'all' && s.wilayah !== wilayahVal) return false;
      if (statusVal !== 'all' && s.statusValidasi !== statusVal) return false;
      if (incidentsEnabled && incidentVal !== 'all') {
        const inc = incidentsFor(s.candidateId);
        return incidentVal === 'has-incident' ? inc.length > 0 : inc.some(i => i.jenis === incidentVal);
      }
      return true;
    });

    const total = sppgList.length;
    const count = byId('active-marker-count');
    if (count) count.textContent = filtered.length === total ? `${total} titik SPPG` : `${filtered.length} dari ${total} titik`;
    const active = !!q || [wilayahVal, statusVal, incidentVal].some(v => v !== 'all');
    byId('map-filter-reset')?.classList.toggle('hidden', !active);

    renderList(false);
    renderMapMarkers(fit);
  }

  function renderList(more: boolean) {
    const list = byId('map-point-list');
    if (!list) return;
    listLimit = more ? listLimit + LIST_PAGE : LIST_PAGE;
    const shown = filtered.slice(0, listLimit);

    list.innerHTML = shown.map(s => `
      <li>
        <button type="button" class="map-point" data-id="${escapeHtml(s.candidateId)}">
          <span class="map-point-dot" style="background: ${markerColor(s)}" aria-hidden="true"></span>
          <span class="min-w-0">
            <span class="block text-xs font-semibold text-white leading-snug">${escapeHtml(s.nama)}</span>
            <span class="block text-[11px] text-ink-muted">${escapeHtml(s.kecamatan || 'Kecamatan tidak diketahui')} · ${escapeHtml(shortWilayah(s.wilayah))}</span>
          </span>
        </button>
      </li>`).join('');

    byId('map-list-empty')?.classList.toggle('hidden', filtered.length > 0);
    const remaining = filtered.length - shown.length;
    byId('map-list-more')?.classList.toggle('hidden', remaining <= 0);
    const moreBtn = byId('map-list-more-btn');
    if (moreBtn) moreBtn.textContent = `Tampilkan ${Math.min(LIST_PAGE, remaining)} titik lagi`;
  }

  // 3. Peta Leaflet
  function showMapStatus(text: string | null, retry = false) {
    const box = byId('map-status');
    if (!box) return;
    box.classList.toggle('hidden', text === null);
    if (text !== null) {
      const t = byId('map-status-text');
      if (t) t.textContent = text;
      byId('map-status-retry')?.classList.toggle('hidden', !retry);
    }
  }

  // Peta dasar dipakai peta utama dan mini peta di modal detail.
  const OSM_ATTR = '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors';
  const TILE_DEFS: Record<string, [string, Record<string, unknown>]> = {
    dark: ['https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?key=cb1_4oqq_1_6432e1ac4153b1217ab5d340', {
      attribution: `${OSM_ATTR} &copy; <a href="https://carto.com/attributions" target="_blank" rel="noopener noreferrer">CARTO</a>`,
      subdomains: 'abcd',
      className: 'tiles-warm',
    }],
    osm: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: OSM_ATTR }],
    satellite: ['https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { attribution: 'Tiles &copy; Esri' }],
  };
  const makeTile = (L: any, key: string) => {
    const [url, opts] = TILE_DEFS[key] ?? TILE_DEFS.osm;
    return L.tileLayer(url, { maxZoom: 19, ...opts });
  };

  // Leaflet dimuat dari CDN di Layout. Bila belum ada setelah 10 detik, tampilkan pesan gagal.
  let leafletWait = 0;
  function initLeafletMap() {
    const mapContainer = byId('leaflet-map');
    if (!mapContainer || typeof (window as any).L === 'undefined') {
      leafletWait += 200;
      if (leafletWait >= 10000) {
        showMapStatus('Peta gagal dimuat. Cek koneksi, lalu muat ulang.', true);
        byId('map-status-retry')?.addEventListener('click', () => location.reload(), { once: true });
        return;
      }
      setTimeout(initLeafletMap, 200);
      return;
    }
    const L = (window as any).L;

    currentMap = L.map('leaflet-map', { center: BANDUNG_CENTER, zoom: 11, zoomControl: false, attributionControl: true });
    // Catatan asal data dipindah dari panel ke baris atribusi supaya panel tidak penuh.
    currentMap.attributionControl.setPrefix('Data pilot, belum diverifikasi BGN · <a href="https://leafletjs.com" target="_blank" rel="noopener noreferrer">Leaflet</a>');
    L.control.zoom({ position: 'topright', zoomInTitle: 'Perbesar', zoomOutTitle: 'Perkecil' }).addTo(currentMap);
    addResetControl(L);

    const tiles: Record<string, any> = {
      dark: makeTile(L, 'dark'),
      osm: makeTile(L, 'osm'),
      satellite: makeTile(L, 'satellite'),
    };

    // Peringatan ubin gagal hilang lagi begitu layer berhasil dimuat (atau ganti peta dasar).
    const tileWarning = byId('map-tile-warning');
    Object.values(tiles).forEach(layer => {
      layer.on('tileerror', () => tileWarning?.classList.remove('hidden'));
      layer.on('load', () => tileWarning?.classList.add('hidden'));
    });

    // Ganti peta dasar dengan crossfade: layer baru ditaruh di atas dengan opacity 0, memudar masuk
    // setelah ubinnya termuat (transisi di map-panel.css), lalu layer lama dilepas. Tanpa ini peta
    // sempat kosong sekejap saat layer lama dicopot sebelum ubin baru datang.
    let activeTile = tiles.osm.addTo(currentMap);
    let switchId = 0;
    const tileSelect = byId<HTMLSelectElement>('map-select-tile');
    tileSelect?.addEventListener('change', () => {
      const next = tiles[tileSelect.value];
      if (!next || next === activeTile) return;
      tileWarning?.classList.add('hidden');
      const id = ++switchId;
      const prev = activeTile;
      activeTile = next;
      // Layer dari pergantian sebelumnya yang belum selesai ikut dibersihkan.
      Object.values(tiles).forEach(t => {
        if (t !== prev && t !== next && currentMap.hasLayer(t)) currentMap.removeLayer(t);
      });
      next.setOpacity(0);
      if (!currentMap.hasLayer(next)) next.addTo(currentMap);
      next.bringToFront();

      let shown = false;
      const reveal = () => {
        if (shown || id !== switchId) return;
        shown = true;
        next.setOpacity(1);
        setTimeout(() => {
          if (id === switchId && prev !== activeTile) currentMap.removeLayer(prev);
        }, 520);
      };
      next.once('load', reveal);
      setTimeout(reveal, 1500);
    });

    markersLayer = L.layerGroup().addTo(currentMap);
    renderMapMarkers(true);
    showMapStatus(null);

    // Tombol di dalam popup dibuat ulang tiap popup dibuka, jadi klik ditangkap di kontainer.
    mapContainer.addEventListener('click', e => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.popup-detail-btn');
      if (btn?.dataset.id) openSPPGModal(btn.dataset.id);
    });
  }

  function fitAll() {
    const L = (window as any).L;
    const entries = [...markerById.values()];
    if (entries.length) {
      currentMap.flyToBounds(L.featureGroup(entries.map(m => m.marker)).getBounds().pad(0.12), { duration: 1.0 });
    } else {
      currentMap.flyTo(BANDUNG_CENTER, 11, { duration: 1.0 });
    }
  }

  function addResetControl(L: any) {
    const ResetControl = L.Control.extend({
      options: { position: 'topright' },
      onAdd() {
        const bar = L.DomUtil.create('div', 'leaflet-bar');
        const a = L.DomUtil.create('a', 'map-reset-ctl', bar);
        a.href = '#';
        a.title = 'Tampilkan semua titik';
        a.setAttribute('role', 'button');
        a.setAttribute('aria-label', 'Tampilkan semua titik yang sesuai filter');
        a.innerHTML = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"/></svg>`;
        L.DomEvent.disableClickPropagation(bar);
        L.DomEvent.on(a, 'click', (e: Event) => {
          L.DomEvent.preventDefault(e);
          fitAll();
        });
        return bar;
      },
    });
    new ResetControl().addTo(currentMap);
  }

  // Popup = satu-satunya tempat info titik. Semua teks di-escape.
  function popupHtml(s: SPPG) {
    const st = statusInfo(s.statusValidasi);
    const inc = incidentsFor(s.candidateId);
    const last = inc[inc.length - 1];
    return `
      <div class="space-y-2 text-xs" style="min-width: 220px">
        <div class="flex items-center justify-between gap-2 border-b border-white/10 pb-1.5">
          <span class="text-[11px] text-ink-muted font-semibold">${escapeHtml(shortWilayah(s.wilayah))}</span>
          <span class="text-[10px] px-2 py-0.5 rounded-md font-mono ${st.badge}">${escapeHtml(st.label)}</span>
        </div>
        <h2 class="font-display text-base text-white leading-snug">${escapeHtml(s.nama)}</h2>
        <dl class="space-y-1 text-[11px]">
          <div><dt class="text-ink-muted inline">Kecamatan: </dt><dd class="text-ink-2 inline">${escapeHtml(s.kecamatan || 'Tidak diketahui')}</dd></div>
          <div><dt class="text-ink-muted inline">Alamat: </dt><dd class="text-ink-2 inline">${escapeHtml(s.alamat || 'Tidak tersedia')}</dd></div>
          <div><dt class="text-ink-muted inline">Koordinat: </dt><dd class="text-ink-2 inline font-mono">${formatCoord(s.lat)}, ${formatCoord(s.lng)}</dd></div>
        </dl>
        ${last ? `<p class="p-2 rounded-md bg-rose-500/15 border border-rose-500/30 text-rose-200 text-[11px]"><strong>${escapeHtml(last.jenis)}:</strong> ${escapeHtml(last.deskripsi)}</p>` : ''}
        <div class="grid grid-cols-2 gap-2 pt-1">
          <button type="button" data-id="${escapeHtml(s.candidateId)}"
             class="popup-detail-btn min-h-11 rounded-lg border border-rule-strong bg-paper text-ink text-xs font-semibold hover:border-accent hover:text-accent transition-colors focus-visible:outline-2 focus-visible:outline-accent">
            Detail lengkap
          </button>
          <a href="${escapeHtml(mapsUrl(s))}" target="_blank" rel="noopener noreferrer"
             class="min-h-11 grid place-items-center rounded-lg bg-accent hover:bg-amber-400 text-center font-semibold text-xs transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
             style="color: #000">
            Google Maps
          </a>
        </div>
      </div>
    `;
  }

  function markerColor(s: SPPG) {
    if (incidentsEnabled) {
      const inc = incidentsFor(s.candidateId);
      if (inc.some(i => i.jenis === 'Keracunan')) return '#c2412d';
      if (inc.length) return '#e0913a';
    }
    return statusInfo(s.statusValidasi).marker;
  }

  function renderMapMarkers(fit: boolean) {
    if (!currentMap || !markersLayer) return;
    const L = (window as any).L;

    // Penanda dibuat sekali lalu dipakai ulang. Filter hanya memasang/melepas penanda dari layer,
    // jadi mengetik di pencarian tidak membangun ulang 219 elemen DOM.
    if (!allMarkers.size) {
      sppgList.forEach(sppg => {
        if (!Number.isFinite(sppg.lat) || !Number.isFinite(sppg.lng)) return;
        const icon = L.divIcon({
          className: 'custom-leaflet-marker',
          html: `<div class="sppg-pin" style="background-color: ${markerColor(sppg)}"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg></div>`,
          iconSize: [32, 32],
          iconAnchor: [16, 16],
          popupAnchor: [0, -18],
        });
        const marker = L.marker([sppg.lat, sppg.lng], { icon, title: sppg.nama, alt: sppg.nama, keyboard: true });
        marker.bindPopup(() => popupHtml(sppg), { maxWidth: 300, autoPanPaddingTopLeft: autoPanTopLeft() });
        marker.on('popupopen', () => markListItem(sppg.candidateId));
        marker.on('popupclose', () => markListItem(null));
        allMarkers.set(sppg.candidateId, { id: sppg.candidateId, marker, sppg });
      });
    }

    const next = new Map<string, MarkerEntry>();
    filtered.forEach(s => {
      const m = allMarkers.get(s.candidateId);
      if (m) next.set(s.candidateId, m);
    });
    markerById.forEach((m, id) => { if (!next.has(id)) markersLayer.removeLayer(m.marker); });
    next.forEach((m, id) => { if (!markerById.has(id)) markersLayer.addLayer(m.marker); });
    markerById = next;

    if (fit && markerById.size) {
      currentMap.fitBounds(L.featureGroup([...markerById.values()].map(m => m.marker)).getBounds().pad(0.12), fitPadding());
    }
  }

  // Ruang yang ditutupi panel, supaya penanda dan popup tidak tersembunyi di baliknya.
  function panelOffset(): [number, number] {
    const panel = byId('map-panel');
    if (!panel || panel.dataset.open !== 'true') return [0, (panel?.offsetHeight ?? 0) + 8];
    return isDesktop.matches ? [panel.offsetWidth + 12, 0] : [0, panel.offsetHeight + 8];
  }
  const autoPanTopLeft = () => {
    const [x, y] = panelOffset();
    return [x + 10, y + 10];
  };
  const fitPadding = () => {
    const [x, y] = panelOffset();
    return { paddingTopLeft: [x + 16, y + 16], paddingBottomRight: [56, 24] };
  };

  function markListItem(id: string | null) {
    document.querySelectorAll<HTMLElement>('.map-point').forEach(b => {
      if (b.dataset.id === id) b.setAttribute('aria-current', 'true');
      else b.removeAttribute('aria-current');
    });
  }

  // Fokuskan peta ke satu titik. Filter di-reset bila titiknya sedang tersembunyi.
  function focusMarker(id: string) {
    if (!currentMap) return;
    if (!markerById.has(id)) resetFilters();
    const target = markerById.get(id);
    if (!target) return;
    // Di HP panel ditutup dulu agar peta dan popup terlihat penuh.
    if (!isDesktop.matches) { panelWanted = false; setPanel(false); }
    const [x] = panelOffset();
    const point = currentMap.project([target.sppg.lat, target.sppg.lng], 16).subtract([x / 2, 0]);
    currentMap.flyTo(currentMap.unproject(point, 16), 16, { duration: 1.0 });
    currentMap.once('moveend', () => target.marker.openPopup());
  }

  // 4. Modal detail (dibuka dari tombol "Detail lengkap" di popup)
  let lastFocused: HTMLElement | null = null;

  function initModalHandlers() {
    const modal = byId('detail-modal');
    byId('modal-close-btn')?.addEventListener('click', () => closeModal());
    modal?.addEventListener('click', e => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
    });
  }

  // Buka: kelas dm-open memicu animasi masuk (map-panel.css). Tutup: dm-closing diputar dulu,
  // baru modal disembunyikan. Reduced motion: CSS mematikan animasinya, jadi langsung.
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  function openModal() {
    const modal = byId('detail-modal');
    if (!modal) return;
    clearTimeout(closeTimer);
    if (modal.classList.contains('hidden')) lastFocused = document.activeElement as HTMLElement | null;
    modal.classList.remove('hidden', 'dm-closing');
    // Paksa reflow supaya animasi masuk diputar ulang tiap kali dibuka.
    modal.classList.remove('dm-open');
    void modal.offsetWidth;
    modal.classList.add('dm-open');
    byId('modal-close-btn')?.focus();
  }

  function closeModal(restoreFocus = true) {
    const modal = byId('detail-modal');
    if (!modal || modal.classList.contains('hidden')) return;
    modal.classList.remove('dm-open');
    modal.classList.add('dm-closing');
    const ms = reduceMotion.matches ? 0 : 200;
    closeTimer = setTimeout(() => {
      modal.classList.add('hidden');
      modal.classList.remove('dm-closing');
    }, ms);
    if (restoreFocus) lastFocused?.focus();
  }

  // Mini peta lokasi di modal: dibuat sekali, dipakai ulang. Tidak bisa digeser (hanya penanda posisi).
  let miniMap: any = null;
  let miniTileKey = '';
  let miniTile: any = null;
  let miniMarker: any = null;

  function showMiniMap(sppg: SPPG) {
    const L = (window as any).L;
    const el = byId('modal-minimap');
    if (!L || !el) return;
    if (!miniMap) {
      miniMap = L.map(el, {
        zoomControl: false, attributionControl: true, dragging: false, scrollWheelZoom: false,
        doubleClickZoom: false, boxZoom: false, keyboard: false, touchZoom: false,
      });
      miniMap.attributionControl.setPrefix(false);
    } else if (miniMap.getContainer() !== el) {
      // Isi modal dibangun ulang tiap dibuka; pindahkan kontainer lama ke tempat yang baru.
      el.replaceWith(miniMap.getContainer());
    }
    const key = byId<HTMLSelectElement>('map-select-tile')?.value || 'osm';
    if (key !== miniTileKey) {
      if (miniTile) miniMap.removeLayer(miniTile);
      miniTile = makeTile(L, key).addTo(miniMap);
      miniTileKey = key;
    }
    const pos = [sppg.lat, sppg.lng];
    miniMap.invalidateSize();
    miniMap.setView(pos, 16, { animate: false });
    // Digeser sedikit ke bawah: bagian atas mini peta tertutup label koordinat.
    miniMap.panBy([0, -18], { animate: false });
    if (miniMarker) miniMap.removeLayer(miniMarker);
    miniMarker = L.marker(pos, {
      interactive: false,
      icon: L.divIcon({
        className: 'custom-leaflet-marker',
        html: `<div class="dm-pin"><div class="sppg-pin" style="background-color: ${markerColor(sppg)}"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg></div></div>`,
        iconSize: [32, 32],
        iconAnchor: [16, 16],
      }),
    }).addTo(miniMap);
    // Ukur ulang setelah animasi kartu selesai (tata letak modal di HP baru stabil saat itu),
    // supaya ubin mengisi penuh mini peta.
    setTimeout(() => {
      if (!miniMap) return;
      miniMap.invalidateSize();
      miniMap.setView(pos, 16, { animate: false });
      miniMap.panBy([0, -18], { animate: false });
    }, 650);
  }

  // Tombol salin: tulis ke clipboard, tampilkan "Disalin" sebentar, atau pesan gagal.
  function bindCopyButtons(root: HTMLElement) {
    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(btn => {
      const label = btn.querySelector('span');
      const idle = label?.textContent || 'Salin';
      btn.addEventListener('click', async () => {
        let ok = true;
        try {
          await navigator.clipboard.writeText(btn.dataset.copy || '');
        } catch {
          ok = false;
        }
        btn.dataset.state = ok ? 'done' : 'fail';
        if (label) label.textContent = ok ? 'Disalin' : 'Gagal';
        setTimeout(() => {
          delete btn.dataset.state;
          if (label) label.textContent = idle;
        }, 1600);
      });
    });
  }

  const COPY_ICON = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path stroke-linecap="round" d="M5 15V5a2 2 0 012-2h10"/></svg>`;
  const copyBtn = (value: string, what: string) =>
    `<button type="button" class="dm-copy" data-copy="${escapeHtml(value)}" aria-label="Salin ${what}">${COPY_ICON}<span>Salin</span></button>`;

  function openSPPGModal(id: string) {
    const sppg = sppgList.find(s => s.candidateId === id);
    const modal = byId('detail-modal');
    const eyebrow = byId('modal-eyebrow');
    const title = byId('modal-title');
    const status = byId('modal-status');
    const body = byId('modal-body');
    if (!sppg || !modal || !eyebrow || !title || !status || !body) return;

    const st = statusInfo(sppg.statusValidasi);
    const coord = `${formatCoord(sppg.lat)}, ${formatCoord(sppg.lng)}`;
    modal.style.setProperty('--dm-tone', markerColor(sppg));
    eyebrow.textContent = [shortWilayah(sppg.wilayah), sppg.kecamatan].filter(Boolean).join(' · ');
    title.textContent = sppg.nama;
    status.textContent = st.label;

    const fact = (label: string, value: string) =>
      `<div class="dm-fact" data-dm-item><dt>${label}</dt><dd>${escapeHtml(value)}</dd></div>`;

    body.innerHTML = `
      <div class="dm-map" data-dm-item>
        <div id="modal-minimap" class="w-full h-full" aria-hidden="true"></div>
        <div class="dm-map-coord">
          <span class="font-mono">${coord}</span>
          ${copyBtn(coord, 'koordinat')}
        </div>
      </div>

      <dl class="dm-facts">
        ${fact('Kecamatan', sppg.kecamatan || 'Tidak diketahui')}
        ${fact('Kabupaten/Kota', sppg.wilayah)}
        ${fact('Status operasional', 'Belum diketahui')}
      </dl>

      <div class="dm-block" data-dm-item>
        <div class="flex items-center justify-between gap-2">
          <h4 class="dm-label">Alamat</h4>
          ${sppg.alamat ? copyBtn(sppg.alamat, 'alamat') : ''}
        </div>
        <p class="mt-1.5 text-sm text-ink leading-relaxed">${escapeHtml(sppg.alamat || 'Tidak tersedia di sumber data')}</p>
      </div>

      ${sppg.catatanReview ? `
        <div class="dm-block dm-block--review" data-dm-item>
          <h4 class="dm-label text-amber-300">Catatan review</h4>
          <p class="mt-1.5 text-sm text-ink-2 leading-relaxed">${escapeHtml(sppg.catatanReview)}</p>
        </div>` : ''}

      ${incidentsEnabled ? `<div data-dm-item>${incidentHistoryHtml(incidentsFor(sppg.candidateId))}</div>` : ''}

      <details class="dm-source" data-dm-item>
        <summary>Asal data</summary>
        <dl class="mt-2 space-y-1 text-[11px]">
          <div><dt class="inline text-ink-muted">Sumber: </dt><dd class="inline">${escapeHtml(sppg.sumber || 'Tidak tercatat')}</dd></div>
          <div><dt class="inline text-ink-muted">ID kandidat: </dt><dd class="inline font-mono">${escapeHtml(sppg.candidateId)}</dd></div>
          ${sppg.fileAsal ? `<div><dt class="inline text-ink-muted">File asal: </dt><dd class="inline font-mono break-all">${escapeHtml(sppg.fileAsal)}</dd></div>` : ''}
        </dl>
      </details>
    `;

    // Urutan animasi masuk: kepala dulu, lalu isi dari atas ke bawah.
    modal.querySelectorAll<HTMLElement>('[data-dm-item]').forEach((el, i) => el.style.setProperty('--k', String(i)));
    bindCopyButtons(body);

    const gmaps = byId<HTMLAnchorElement>('modal-gmaps-link');
    if (gmaps) {
      gmaps.href = mapsUrl(sppg);
      gmaps.setAttribute('aria-label', `Buka ${sppg.nama} di Google Maps (tab baru)`);
    }

    const mapBtn = byId('modal-action-map-btn');
    if (mapBtn) {
      mapBtn.onclick = () => {
        closeModal(false);
        lastFocused = null;
        focusMarker(sppg.candidateId);
      };
    }
    openModal();
    showMiniMap(sppg);
  }

  function incidentHistoryHtml(items: Incident[]) {
    return `
      <div>
        <h4 class="font-bold text-white mb-2">Riwayat Laporan Kejadian (${items.length})</h4>
        ${items.length === 0
          ? `<div class="p-4 rounded-lg bg-paper border border-rule text-center text-ink-muted">Belum ada laporan terverifikasi untuk titik ini.</div>`
          : `<div class="space-y-2 max-h-48 overflow-y-auto pr-1">${items.map(inc => `
              <div class="p-3 rounded-lg bg-paper border border-rule flex flex-col gap-1">
                <div class="flex items-center justify-between font-mono text-[10px]">
                  <span class="text-rose-400 font-bold">${escapeHtml(inc.jenis)}</span>
                  <span class="text-ink-muted">${escapeHtml(inc.tanggal)}</span>
                </div>
                <p class="text-xs text-ink-2">${escapeHtml(inc.deskripsi)}</p>
                <p class="text-[11px] text-ink-muted">Sumber: ${escapeHtml(inc.sumber)}</p>
              </div>`).join('')}</div>`}
      </div>`;
  }
</script>
