---
import '../styles/landing.css';
import MotionHead from '../components/MotionHead.astro';
import { sppgList } from '../data/sppg';
import { summary, wilayahCounts, shortWilayah } from '../data/summary';
import { PLOT_W, PLOT_H, toXY } from '../data/projection';

const { totalKandidat, totalWilayah, totalKecamatan, belumDiverifikasi, perluReview, terverifikasi } = summary;
const tanpaKecamatan = sppgList.filter(s => !s.kecamatan).length;
const pct = (n: number) => ((n / totalKandidat) * 100).toFixed(1).replace('.', ',');

// Plot sebaran dari koordinat asli (proyeksi bersama di src/data/projection.ts).
const W = PLOT_W;
const H = PLOT_H;
// Titik "perlu review" digambar terakhir supaya tidak tertutup titik lain.
const points = [...sppgList]
  .sort((a, b) => Number(a.statusValidasi === 'perlu_review') - Number(b.statusValidasi === 'perlu_review'))
  .map(s => {
    const p = toXY(s.lat, s.lng);
    // Jeda muncul sebanding posisi barat-timur, untuk animasi sapuan.
    return { ...p, review: s.statusValidasi === 'perlu_review', delay: Math.round(400 + (p.x / W) * 1100) };
  });

const maxWilayah = wilayahCounts[0]?.[1] ?? 1;
const [topWilayah, topCount] = wilayahCounts[0] ?? ['', 0];

// Garis yang tergambar mengikuti scroll. Path dari Skiper 19 (Skiper UI, @gurvinder-singh02),
// lisensi gratis dengan atribusi; kreditnya ada di footer. Warna diganti ember gelap.
const LINE_PATH = 'M876.605 394.131C788.982 335.917 696.198 358.139 691.836 416.303C685.453 501.424 853.722 498.43 941.95 409.714C1016.1 335.156 1008.64 186.907 906.167 142.846C807.014 100.212 712.699 198.494 789.049 245.127C889.053 306.207 986.062 116.979 840.548 43.3233C743.932 -5.58141 678.027 57.1682 672.279 112.188C666.53 167.208 712.538 172.943 736.353 163.088C760.167 153.234 764.14 120.924 746.651 93.3868C717.461 47.4252 638.894 77.8642 601.018 116.979C568.164 150.908 557 201.079 576.467 246.924C593.342 286.664 630.24 310.55 671.68 302.614C756.114 286.446 729.747 206.546 681.86 186.442C630.54 164.898 492 209.318 495.026 287.644C496.837 334.494 518.402 366.466 582.455 367.287C680.013 368.538 771.538 299.456 898.634 292.434C1007.02 286.446 1192.67 309.384 1242.36 382.258C1266.99 418.39 1273.65 443.108 1247.75 474.477C1217.32 511.33 1149.4 511.259 1096.84 466.093C1044.29 420.928 1029.14 380.576 1033.97 324.172C1038.31 273.428 1069.55 228.986 1117.2 216.384C1152.2 207.128 1188.29 213.629 1194.45 245.127C1201.49 281.062 1132.22 280.104 1100.44 272.673C1065.32 264.464 1044.22 234.837 1032.77 201.413C1019.29 162.061 1029.71 131.126 1056.44 100.965C1086.19 67.4032 1143.96 54.5526 1175.78 86.1513C1207.02 117.17 1186.81 143.379 1156.22 166.691C1112.57 199.959 1052.57 186.238 999.784 155.164C957.312 130.164 899.171 63.7054 931.284 26.3214C952.068 2.12513 996.288 3.87363 1007.22 43.58C1018.15 83.2749 1003.56 122.644 975.969 163.376C948.377 204.107 907.272 255.122 913.558 321.045C919.727 385.734 990.968 497.068 1063.84 503.35C1111.46 507.456 1166.79 511.984 1175.68 464.527C1191.52 379.956 1101.26 334.985 1030.29 377.017C971.109 412.064 956.297 483.647 953.797 561.655C947.587 755.413 1197.56 941.828 936.039 1140.66C745.771 1285.32 321.926 950.737 134.536 1202.19C-6.68295 1391.68 -53.4837 1655.38 131.935 1760.5C478.381 1956.91 1124.19 1515 1201.28 1997.83C1273.66 2451.23 100.805 1864.7 303.794 2668.89';
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SIGMA-B</title>
  <meta name="description" content={`Peta ${totalKandidat} titik kandidat SPPG di Bandung Raya. Data pilot dari Google Maps, belum diverifikasi resmi.`} />
  <meta name="theme-color" content="#100904" />
  <link rel="icon" type="image/svg+xml" href="/img/SIGMA-B — Simbol koordinat.svg" />
  <MotionHead />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400..700&display=swap" rel="stylesheet" />
  <!-- Lenis: scroll halus, versi sama dengan dashboard -->
  <link rel="stylesheet" href="https://unpkg.com/lenis@1.1.18/dist/lenis.css" />
  <script is:inline src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
</head>
<body>
  <a class="lp-skip" href="#utama" data-native-anchor>Lewati ke konten utama</a>

  <header class="lp-header">
    <div class="lp-wrap">
      <a class="lp-brand" href="/" style="view-transition-name: brand">
        <img src="/img/SIGMA-B — Simbol koordinat.svg" alt="Logo SIGMA-B" class="lp-brand-mark" width="32" height="32" />
        <span>SIGMA-B</span>
      </a>
      <nav class="lp-nav" aria-label="Navigasi halaman">
        <a class="lp-nav-link" href="#sebaran">Sebaran</a>
        <a class="lp-nav-link" href="#data">Asal data</a>
        <a class="btn-split" href="/peta">Buka peta</a>
      </nav>
    </div>
  </header>

  <main id="utama" class="lp-main">
    <svg class="lp-line" viewBox="0 0 1278 2319" fill="none" overflow="visible" aria-hidden="true">
      <path d={LINE_PATH} stroke="#b4460a" stroke-width="30" stroke-linecap="round" stroke-linejoin="round" />
    </svg>

    <!-- Hero: teks di tengah lalu tiga panel bergaya layar (pola Hero 37), isinya data asli. -->
    <section class="lp-hero" aria-labelledby="judul">
      <div class="lp-wrap lp-hero-text">
        <p class="lp-label" data-reveal>Dataset pilot · {totalWilayah} kab/kota · {totalKecamatan} kecamatan</p>
        <h1 id="judul" class="lp-display" data-reveal style="--i:1">Peta {totalKandidat} titik kandidat SPPG di Bandung Raya</h1>
        <p class="lp-lede" data-reveal style="--i:2">
          Lokasi kandidat dapur Makan Bergizi Gratis dari Google Maps, lengkap dengan status verifikasinya.
        </p>
        <div class="lp-actions" data-reveal style="--i:3">
          <a class="btn-split btn-split--lg" href="/peta">Buka peta interaktif</a>
          <a class="lp-btn-ghost" href="#data">Baca asal data</a>
        </div>
      </div>

      <div class="lp-wrap lp-devices">
        <div class="lp-slot lp-slot--left" data-reveal style="--i:5">
          <figure class="lp-device lp-device--phone">
            <figcaption class="lp-device-title">Titik per kab/kota</figcaption>
            <ol class="lp-mini">
              {wilayahCounts.map(([w, n]) => (
                <li>
                  <span class="lp-mini-row"><span>{shortWilayah(w)}</span><strong>{n}</strong></span>
                  <span class="lp-mini-bar" aria-hidden="true"><span style={`width: ${(n / maxWilayah) * 100}%`}></span></span>
                </li>
              ))}
            </ol>
          </figure>
        </div>

        <div class="lp-slot lp-slot--center" data-reveal style="--i:4">
          <figure class="lp-device lp-plot" style="view-transition-name: peta">
            <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Plot koordinat ${totalKandidat} titik kandidat SPPG. ${perluReview} titik perlu review manual.`}>
              {points.map(p => (
                <circle cx={p.x} cy={p.y} r={p.review ? 5 : 3.5} fill={p.review ? 'var(--color-ember-accent)' : 'var(--color-warm-cream)'} fill-opacity={p.review ? 1 : 0.8} style={`--d:${p.delay}ms`} />
              ))}
            </svg>
            <figcaption>
              Tiap titik satu kandidat, utara di atas.
              <span class="lp-key lp-key--cream" aria-hidden="true"></span>belum diverifikasi
              <span class="lp-key lp-key--ember" aria-hidden="true"></span>perlu review manual
            </figcaption>
          </figure>
        </div>

        <div class="lp-slot lp-slot--right" data-reveal style="--i:6">
          <figure class="lp-device lp-device--phone">
            <figcaption class="lp-device-title">Status verifikasi</figcaption>
            <dl class="lp-status">
              <div><dt>Belum diverifikasi</dt><dd>{belumDiverifikasi}</dd></div>
              <div><dt>Perlu review</dt><dd class="is-review">{perluReview}</dd></div>
              <div><dt>Terverifikasi</dt><dd>{terverifikasi}</dd></div>
            </dl>
            <span class="lp-status-bar" aria-hidden="true">
              <span style={`width: ${(belumDiverifikasi / totalKandidat) * 100}%`}></span>
              <span class="is-review" style={`width: ${(perluReview / totalKandidat) * 100}%`}></span>
            </span>
          </figure>
        </div>
      </div>
    </section>

    <section id="sebaran" class="lp-section" aria-labelledby="judul-sebaran">
      <div class="lp-wrap">
        <h2 id="judul-sebaran" class="lp-heading" data-reveal>Sebaran per kab/kota</h2>
        <p class="lp-intro" data-reveal style="--i:1">{topWilayah} terbanyak, {topCount} dari {totalKandidat} titik. Klik wilayah untuk melihatnya di peta.</p>
        <ol class="lp-rank">
          {wilayahCounts.map(([w, n], i) => (
            <li data-reveal style={`--i:${i}`}>
              <a href={`/peta?wilayah=${encodeURIComponent(w)}`} aria-label={`${w}: ${n} titik. Buka di peta`}>
                <span class="lp-rank-name">{w}</span>
                <span class="lp-rank-bar" aria-hidden="true"><span style={`width: ${(n / maxWilayah) * 100}%`}></span></span>
                <span class="lp-rank-count">{n}<small>{pct(n)}%</small></span>
                <span class="lp-rank-go" aria-hidden="true">Lihat di peta</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="data" class="lp-section" aria-labelledby="judul-data">
      <div class="lp-wrap lp-split">
        <div data-reveal>
          <h2 id="judul-data" class="lp-heading">Asal dan batasan data</h2>
          <p class="lp-intro">Semua titik masih kandidat. Ini sumber dan batasan datanya.</p>
        </div>
        <dl class="lp-notes" data-reveal style="--i:1">
          <div>
            <dt>Sumber</dt>
            <dd>Ekstraksi Google Maps untuk studi pilot. Bukan data resmi BGN atau pemda.</dd>
          </div>
          <div>
            <dt>Status verifikasi</dt>
            <dd>
              <strong>{belumDiverifikasi}</strong> belum diverifikasi, <strong>{perluReview}</strong> perlu review manual, <strong>{terverifikasi}</strong> terverifikasi.
              Status ini soal benar tidaknya lokasi, bukan soal dapur sudah beroperasi.
              {tanpaKecamatan > 0 && <> {tanpaKecamatan} titik tidak punya alamat dan kecamatan.</>}
            </dd>
          </div>
          <div>
            <dt>Yang tidak ditampilkan</dt>
            <dd>Kapasitas porsi, jumlah penerima, sekolah mitra, kontak, dan status operasional. Sumbernya tidak memuat data ini, jadi tidak kami isi dengan perkiraan.</dd>
          </div>
          <div>
            <dt>Penggunaan</dt>
            <dd>Hanya untuk keperluan akademik. Ketentuan Google Maps membatasi penampilan ulang datanya di peta lain.</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Kartu penutup bergaya Skiper 19: judul raksasa + empat keterangan, isinya fakta proyek. -->
    <section class="lp-outro" aria-labelledby="judul-penutup">
      <div class="lp-wrap">
        <div class="lp-outro-card" data-reveal>
          <h2 id="judul-penutup" class="lp-outro-big">SPPG<br />Bandung Raya</h2>
          <dl class="lp-outro-meta">
            <div><dt>Wilayah</dt><dd>Bandung Raya, Jawa Barat<br />{totalWilayah} kab/kota</dd></div>
            <div><dt>Dataset</dt><dd>Pilot, {totalKandidat} titik<br />belum diverifikasi resmi</dd></div>
            <div><dt>Akses</dt><dd>Gratis<br />untuk keperluan akademik</dd></div>
            <div><dt>Dibuat oleh</dt><dd>Kelompok 14<br />Tugas Besar Teknologi Pemetaan Berbasis Web</dd></div>
          </dl>
          <a class="btn-split btn-split--lg lp-outro-cta" href="/peta">Buka peta interaktif</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="lp-footer">
    <div class="lp-wrap">
      <p><strong>Kelompok 14</strong> · Teknologi Pemetaan Berbasis Web</p>
      <p class="lp-credit">Adit dan Ucup</p>
    </div>
  </footer>

  <script>
    import { initReveal, initSmoothScroll } from '../scripts/motion';
    import { initScrollLine } from '../scripts/scroll-line';
    initSmoothScroll();
    initReveal();
    initScrollLine(document.querySelector('.lp-line path'));
  </script>
</body>
</html>
