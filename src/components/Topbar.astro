---
import { summary } from '../data/summary';
---

<header class="h-16 sm:h-20 border-b border-rule bg-paper-2/95 sticky top-0 z-30 px-3 sm:px-6 lg:px-8 flex items-center justify-between gap-3 sm:gap-4">
  <div class="flex items-center gap-2 sm:gap-3.5 min-w-0">
    <!-- Tombol drawer, hanya di bawah lg (sidebar tetap tampil di lg ke atas) -->
    <button
      id="mobile-sidebar-toggle"
      data-drawer-target="default-sidebar"
      data-drawer-toggle="default-sidebar"
      aria-controls="default-sidebar"
      type="button"
      class="lg:hidden inline-flex items-center gap-1.5 min-h-11 px-2.5 -ml-1 rounded-lg text-ink-2 text-xs font-semibold hover:bg-paper-hover hover:text-ink transition-colors shrink-0"
      aria-expanded="false"
    >
      <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path clip-rule="evenodd" fill-rule="evenodd" d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"></path>
      </svg>
      <span>Menu</span>
    </button>

    <div class="flex items-center gap-2.5 min-w-0">
      <img src="/img/SIGMA-B — Simbol koordinat.svg" alt="Logo SIGMA-B" class="w-7 h-7 sm:w-8 sm:h-8 shrink-0" width="32" height="32" />
      <div class="min-w-0">
        <h1 class="text-base xl:text-lg 2xl:text-xl leading-tight font-display font-normal text-white tracking-tight flex items-center gap-2">
          <!-- Nama lengkap baru muat di samping pencarian mulai xl; di bawahnya pakai singkatan. -->
          <span class="xl:hidden">SIGMA-B</span>
          <span class="hidden xl:inline">Sistem Informasi Geospasial MBG Area Bandung (SIGMA-B)</span>
          <span class="hidden 2xl:inline-flex text-[11px] font-mono font-medium px-2 py-0.5 rounded-md bg-paper-3 text-ink-2 border border-rule">Dataset Pilot</span>
        </h1>
        <p class="text-xs text-ink-muted hidden md:block truncate">Sebaran {summary.totalKandidat} titik kandidat SPPG di {summary.totalWilayah} kab/kota, {summary.totalKecamatan} kecamatan</p>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-2 sm:gap-3 shrink-0">
    <!-- Global Quick Search with a11y & Clear button -->
    <div class="search-wrap relative hidden sm:block w-48 md:w-56 xl:w-64">
      <label for="global-search-input" class="sr-only">Cari SPPG, kecamatan, atau wilayah</label>
      <input 
        type="search" 
        id="global-search-input"
        placeholder="Cari SPPG, kecamatan..." 
        aria-label="Cari SPPG, kecamatan, atau wilayah"
        class="search-field w-full pl-9 pr-8 py-2.5 text-xs font-body"
      />
      <svg class="w-4 h-4 text-ink-muted absolute left-3 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <button 
        id="global-search-clear" 
        type="button" 
        aria-label="Hapus kata kunci pencarian"
        class="absolute right-2.5 top-2 text-ink-dim hover:text-white hidden p-0.5"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Sumber data: file statis, diperbarui manual -->
    <!-- <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-paper border border-rule text-xs font-mono" title="Data dimuat dari file statis dan diperbarui manual">
      <span class="w-2 h-2 rounded-sm bg-amber-400" aria-hidden="true"></span>
      <span class="text-ink-muted hidden lg:inline">Data:</span>
      <span class="text-amber-300 font-semibold">Pembaruan Manual</span>
    </div> -->

    <!-- Quick Action to Map -->
    <button 
      id="quick-pan-map-btn" 
      class="btn-split shrink-0 min-h-11 min-w-11 px-3 sm:px-3.5 text-xs sm:text-sm"
      aria-label="Gulir ke peta interaktif"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
        <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
      </svg>
      <span class="hidden sm:inline">Buka Peta</span>
    </button>
  </div>
</header>
