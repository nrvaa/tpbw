---
// Dirender hanya bila incidentsEnabled (lihat src/data/incidents.ts dan src/pages/index.astro).
import { incidentList } from '../data/incidents';
import { wilayahCounts, shortWilayah } from '../data/summary';

const countJenis = (j: string) => incidentList.filter(i => i.jenis === j).length;
---

<div id="section-incidents" class="bento-card rounded-2xl bg-paper-card border border-rule overflow-hidden shadow-lg flex flex-col" role="region" aria-label="Log dan Rekapitulasi Kejadian MBG">
  <!-- Header -->
  <div class="p-5 border-b border-rule bg-paper-2 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-rose-500/15 text-rose-400 flex items-center justify-center border border-rose-500/25">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
      </div>
      <div>
        <h2 class="text-base font-display font-bold text-white tracking-tight flex items-center gap-2">
          <span>Log & Rekapitulasi Data Kejadian MBG</span>
          <span id="incident-count-badge" class="text-xs font-mono font-medium px-2 py-0.5 rounded-full bg-rose-500/15 text-rose-300 border border-rose-500/25">{incidentList.length} Catatan</span>
        </h2>
        <p class="text-xs text-ink-muted">Monitoring keracunan, keluhan penerima manfaat, dan kendala distribusi</p>
      </div>
    </div>

    <!-- Mini stats bar & Export Action -->
    <div class="flex flex-wrap items-center gap-2">
      <div class="px-3 py-1.5 rounded-xl bg-paper border border-rule text-xs font-mono flex items-center gap-2" title="Total Kasus Keracunan">
        <span class="w-2 h-2 rounded-full bg-rose-500" aria-hidden="true"></span>
        <span class="text-ink-muted">Keracunan:</span>
        <span class="text-rose-400 font-bold">{countJenis('Keracunan')}</span>
      </div>
      <div class="px-3 py-1.5 rounded-xl bg-paper border border-rule text-xs font-mono flex items-center gap-2" title="Total Keluhan Layanan">
        <span class="w-2 h-2 rounded-full bg-amber-500" aria-hidden="true"></span>
        <span class="text-ink-muted">Keluhan:</span>
        <span class="text-amber-400 font-bold">{countJenis('Keluhan')}</span>
      </div>
      <div class="px-3 py-1.5 rounded-xl bg-paper border border-rule text-xs font-mono flex items-center gap-2" title="Total Kendala Distribusi">
        <span class="w-2 h-2 rounded-full bg-blue-500" aria-hidden="true"></span>
        <span class="text-ink-muted">Distribusi:</span>
        <span class="text-blue-400 font-bold">{countJenis('Gangguan Distribusi')}</span>
      </div>

      <!-- Export CSV Action Button -->
      <button 
        id="export-incidents-btn"
        class="px-3 py-1.5 rounded-xl bg-paper border border-rule hover:border-rule-strong hover:bg-paper-hover text-ink-2 hover:text-white transition-all text-xs font-medium flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-accent"
        aria-label="Unduh Rekap Laporan Insiden ke format CSV"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        <span>Ekspor CSV</span>
      </button>
    </div>
  </div>

  <!-- Filters Toolbar -->
  <div class="p-4 border-b border-rule bg-paper/60 flex flex-wrap items-center gap-3" role="search" aria-label="Pencarian dan Filter Kejadian">
    <!-- Search -->
    <div class="relative flex-1 min-w-[200px]">
      <label for="incident-search-input" class="sr-only">Cari dalam tabel kejadian</label>
      <input 
        type="search" 
        id="incident-search-input"
        placeholder="Filter berdasarkan nama SPPG, wilayah, atau gejala..." 
        aria-label="Filter berdasarkan nama SPPG, wilayah, atau gejala"
        class="w-full bg-paper border border-rule rounded-xl pl-9 pr-3 py-2 text-xs text-ink placeholder:text-ink-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/40 transition-all"
      />
      <svg class="w-4 h-4 text-ink-muted absolute left-3 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>

    <!-- Jenis Selector -->
    <div>
      <label for="incident-filter-jenis" class="sr-only">Pilih Jenis Kejadian</label>
      <select id="incident-filter-jenis" aria-label="Filter Jenis Kejadian" class="bg-paper border border-rule text-ink text-xs rounded-xl px-3 py-2 cursor-pointer focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/40">
        <option value="all">Semua Jenis Kejadian</option>
        <option value="Keracunan">Keracunan</option>
        <option value="Keluhan">Keluhan Layanan</option>
        <option value="Gangguan Distribusi">Gangguan Distribusi</option>
      </select>
    </div>

    <!-- Wilayah Selector -->
    <div>
      <label for="incident-filter-wilayah" class="sr-only">Pilih Wilayah Kejadian</label>
      <select id="incident-filter-wilayah" aria-label="Filter Wilayah Kejadian" class="bg-paper border border-rule text-ink text-xs rounded-xl px-3 py-2 cursor-pointer focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/40">
        <option value="all">Semua Wilayah</option>
        {wilayahCounts.map(([w]) => <option value={w}>{shortWilayah(w)}</option>)}
      </select>
    </div>

    <!-- Status Selector -->
    <div>
      <label for="incident-filter-status" class="sr-only">Pilih Status Penanganan</label>
      <select id="incident-filter-status" aria-label="Filter Status Penanganan" class="bg-paper border border-rule text-ink text-xs rounded-xl px-3 py-2 cursor-pointer focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/40">
        <option value="all">Semua Status</option>
        <option value="Ditangani">Ditangani</option>
        <option value="Dalam Penanganan">Dalam Penanganan</option>
        <option value="Belum Ditangani">Belum Ditangani</option>
      </select>
    </div>

    <!-- Reset Filter Button -->
    <button 
      id="incident-reset-filters-btn"
      type="button"
      class="px-2.5 py-2 rounded-xl bg-paper border border-rule text-ink-muted hover:text-white hover:bg-paper-hover transition-colors text-xs font-mono focus-visible:ring-2 focus-visible:ring-accent"
      title="Reset semua filter kejadian"
    >
      Reset
    </button>
  </div>

  <!-- Table Container -->
  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs border-collapse">
      <caption class="sr-only">Tabel Log & Rekapitulasi Data Kejadian MBG di Bandung Raya</caption>
      <thead>
        <tr class="border-b border-rule bg-paper-2/70 text-ink-muted font-mono uppercase text-[11px] tracking-wider">
          <th scope="col" class="py-3 px-4">Tanggal</th>
          <th scope="col" class="py-3 px-4">SPPG Terkait</th>
          <th scope="col" class="py-3 px-4">Wilayah</th>
          <th scope="col" class="py-3 px-4">Jenis Kejadian</th>
          <th scope="col" class="py-3 px-4">Urgensi</th>
          <th scope="col" class="py-3 px-4 text-center">Terdampak</th>
          <th scope="col" class="py-3 px-4">Status Penanganan</th>
          <th scope="col" class="py-3 px-4 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody id="incident-table-body" class="divide-y divide-rule font-body">
        {incidentList.map(item => {
          const isKeracunan = item.jenis === "Keracunan";
          const isKeluhan = item.jenis === "Keluhan";
          const isDistribusi = item.jenis === "Gangguan Distribusi";

          return (
            <tr 
              class="hover:bg-paper-hover transition-colors group cursor-pointer incident-row focus-within:bg-paper-hover" 
              data-id={item.id} 
              data-jenis={item.jenis} 
              data-wilayah={item.wilayah} 
              data-status={item.status} 
              data-candidate-id={item.candidateId}
              tabindex="0"
              role="button"
              aria-label={`Lihat rincian insiden ${item.jenis} di ${item.sppgNama}, tanggal ${item.tanggal}`}
            >
              <td class="py-3.5 px-4 font-mono text-ink-muted whitespace-nowrap">
                {item.tanggal}
              </td>
              <td class="py-3.5 px-4 font-semibold text-white whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <span class="group-hover:text-accent transition-colors">{item.sppgNama}</span>
                </div>
              </td>
              <td class="py-3.5 px-4 text-ink-2 whitespace-nowrap">
                {item.wilayah}
              </td>
              <td class="py-3.5 px-4 whitespace-nowrap">
                {isKeracunan && (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-medium bg-rose-500/15 text-rose-300 border border-rose-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500" aria-hidden="true"></span>
                    Keracunan
                  </span>
                )}
                {isKeluhan && (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-medium bg-amber-500/15 text-amber-300 border border-amber-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500" aria-hidden="true"></span>
                    Keluhan
                  </span>
                )}
                {isDistribusi && (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-medium bg-blue-500/15 text-blue-300 border border-blue-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500" aria-hidden="true"></span>
                    Gangguan Distribusi
                  </span>
                )}
              </td>
              <td class="py-3.5 px-4 whitespace-nowrap">
                <span class={`font-mono text-[10px] px-2 py-0.5 rounded font-semibold ${
                  item.tingkatUrgensi === 'Tinggi' ? 'bg-rose-500/15 text-rose-300 border border-rose-500/25' :
                  item.tingkatUrgensi === 'Sedang' ? 'bg-amber-500/15 text-amber-300 border border-amber-500/25' :
                  'bg-emerald-500/15 text-emerald-300 border border-emerald-500/25'
                }`}>
                  {item.tingkatUrgensi}
                </span>
              </td>
              <td class="py-3.5 px-4 text-center font-mono font-bold whitespace-nowrap text-ink">
                {item.terdampak} <span class="font-normal text-[11px] text-ink-muted">jiwa</span>
              </td>
              <td class="py-3.5 px-4 whitespace-nowrap">
                <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium ${
                  item.status === 'Ditangani' ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/25' :
                  item.status === 'Dalam Penanganan' ? 'bg-blue-500/15 text-blue-300 border border-blue-500/25 animate-pulse' :
                  'bg-rose-500/15 text-rose-300 border border-rose-500/25'
                }`}>
                  <span class="w-1.5 h-1.5 rounded-full bg-current" aria-hidden="true"></span>
                  {item.status}
                </span>
              </td>
              <td class="py-3.5 px-4 text-right whitespace-nowrap">
                <button 
                  class="view-incident-btn px-3 py-1.5 rounded-lg bg-paper border border-rule hover:border-accent hover:text-accent text-ink-2 font-medium transition-colors text-xs inline-flex items-center gap-1 focus-visible:ring-2 focus-visible:ring-accent" 
                  data-id={item.id}
                  aria-label={`Buka detail investigasi insiden nomor ${item.id}`}
                >
                  <span>Detail</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>

    <!-- Empty State -->
    <div id="incident-empty-state" class="py-12 px-4 text-center hidden">
      <div class="w-12 h-12 rounded-2xl bg-paper-2 border border-rule mx-auto flex items-center justify-center text-ink-muted mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <h3 class="text-sm font-display font-bold text-white mb-1">Tidak Ada Data Kejadian yang Cocok</h3>
      <p class="text-xs text-ink-muted mb-4 max-w-sm mx-auto">Tidak ditemukan catatan insiden dengan kriteria pencarian dan filter saat ini.</p>
      <button id="incident-empty-reset-btn" class="px-3.5 py-1.5 rounded-xl bg-accent text-white text-xs font-semibold hover:bg-accent/90 transition-all shadow-sm">
        Reset Filter Kejadian
      </button>
    </div>
  </div>
</div>
</div>
