---
import { sppgList } from '../data/sppg';
import { wilayahCounts, statusCounts, statusInfo, shortWilayah, mapsUrl, formatCoord } from '../data/summary';
import { PLOT_W, PLOT_H, toPct } from '../data/projection';

// Jumlah kartu per tampilan; sisanya lewat tombol "Tampilkan lagi" (lihat filterDirectory di peta.astro).
export const DIR_PAGE = 24;
---

<div id="section-directory" class="dir" role="region" aria-label="Direktori titik kandidat SPPG Bandung Raya">
  <div class="dir-head">
    <div class="dir-title">
      <h2>Direktori kandidat</h2>
      <p>
        <span id="sppg-count-badge" class="dir-count" aria-live="polite">{sppgList.length} Titik</span>
        Klik kartu untuk detail, atau tampilkan titiknya di peta.
      </p>
    </div>

    <div class="dir-tools" role="search" aria-label="Filter direktori SPPG">
      <div class="dir-search search-wrap">
        <label for="sppg-search-input" class="sr-only">Cari nama SPPG, kecamatan, atau alamat</label>
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <input type="search" class="search-field" id="sppg-search-input" placeholder="Cari nama, kecamatan, alamat" autocomplete="off" />
      </div>

      <div>
        <label for="sppg-filter-wilayah" class="sr-only">Filter wilayah</label>
        <select id="sppg-filter-wilayah" data-dropdown="Wilayah" data-icon="pin">
          <option value="all" data-icon="list">Semua Wilayah</option>
          {wilayahCounts.map(([w, n]) => <option value={w}>{shortWilayah(w)} ({n})</option>)}
        </select>
      </div>

      <div>
        <label for="sppg-filter-status" class="sr-only">Filter status verifikasi data</label>
        <select id="sppg-filter-status" data-dropdown="Status verifikasi">
          <option value="all" data-icon="list">Semua Status Verifikasi</option>
          {statusCounts.map(([s, n]) => <option value={s} data-dot={statusInfo(s).marker}>{statusInfo(s).label} ({n})</option>)}
        </select>
      </div>

      <button id="sppg-reset-filters-btn" type="button" class="dir-reset" title="Reset semua filter direktori">Reset</button>
    </div>
  </div>

  <div class="dir-grid" id="sppg-cards-container" data-page={DIR_PAGE}>
    {sppgList.map(sppg => {
      const st = statusInfo(sppg.statusValidasi);
      const pos = toPct(sppg.lat, sppg.lng);
      return (
        <article
          class="sppg-card dir-card"
          style={`--dot: ${st.marker}`}
          data-id={sppg.candidateId}
          data-nama={sppg.nama}
          data-wilayah={sppg.wilayah}
          data-status={sppg.statusValidasi}
          aria-labelledby={`sppg-title-${sppg.candidateId}`}>

          <div class="dir-card-top">
            <span class="dir-status"><span class="dir-dot" aria-hidden="true"></span>{st.label}</span>
            <span class="dir-region">{shortWilayah(sppg.wilayah)}</span>
          </div>

          <div class="dir-card-body">
            <div class="min-w-0">
              <h3 id={`sppg-title-${sppg.candidateId}`} class="dir-name">
                <!-- Tombol ini membentang menutupi seluruh kartu (::after), jadi klik di mana pun membuka detail. -->
                <button type="button" class="open-detail-btn dir-name-btn" data-id={sppg.candidateId}>{sppg.nama}</button>
              </h3>
              <p class="dir-addr" title={sppg.alamat}>{sppg.alamat || 'Alamat tidak tersedia'}</p>
            </div>
            <!-- Mini-peta: titik ini di antara semua kandidat (/points.svg). -->
            <span class="dir-mini" style={`aspect-ratio: ${PLOT_W} / ${PLOT_H}`} aria-hidden="true">
              <span class="dir-mini-dot" style={`left: ${pos.left}%; top: ${pos.top}%`}></span>
            </span>
          </div>

          {sppg.catatanReview && (
            <p class="dir-note"><strong>Catatan:</strong> {sppg.catatanReview}</p>
          )}

          <div class="dir-card-foot">
            <span class="dir-meta">
              <span class="dir-meta-kec">{sppg.kecamatan ? `Kec. ${sppg.kecamatan}` : 'Kecamatan tidak diketahui'}</span>
              <span class="dir-meta-coord">{formatCoord(sppg.lat)}, {formatCoord(sppg.lng)}</span>
            </span>
            <span class="dir-actions">
              <button type="button" class="focus-on-map-btn dir-action" data-id={sppg.candidateId} aria-label={`Tampilkan ${sppg.nama} di peta`} title="Tampilkan di peta">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </button>
              <a class="dir-action" href={mapsUrl(sppg)} target="_blank" rel="noopener noreferrer" aria-label={`Buka ${sppg.nama} di Google Maps (tab baru)`} title="Buka di Google Maps">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              </a>
            </span>
          </div>
        </article>
      );
    })}
  </div>

  <div class="dir-more" id="sppg-more">
    <p id="sppg-more-text" aria-live="polite"></p>
    <button id="sppg-load-more" type="button" class="btn-split">Tampilkan {DIR_PAGE} lagi</button>
  </div>

  <div id="sppg-empty-state" class="dir-empty hidden" role="status">
    <h3>Titik tidak ditemukan</h3>
    <p>Tidak ada titik kandidat yang cocok dengan pencarian dan filter saat ini.</p>
    <button id="sppg-empty-reset-btn" type="button" class="btn-split">Reset filter direktori</button>
  </div>
</div>
