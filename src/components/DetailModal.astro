---
---

<div 
  id="detail-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-describedby="modal-body"
>
  <div class="relative w-full max-w-2xl bg-paper-card border border-rule-strong rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh] animate-in fade-in zoom-in-95 duration-150">
    <!-- Modal Header -->
    <div class="p-5 border-b border-rule bg-paper-2 flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
        <div id="modal-badge-icon" class="w-10 h-10 rounded-xl bg-accent/15 text-accent flex items-center justify-center border border-accent/25">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <span id="modal-eyebrow" class="text-[11px] font-mono uppercase tracking-wider text-ink-muted">Detail SPPG</span>
          <h3 id="modal-title" class="text-lg font-display font-bold text-white tracking-tight">Nama Unit</h3>
        </div>
      </div>
      <button 
        id="modal-close-btn" 
        class="p-2 rounded-xl bg-paper border border-rule text-ink-muted hover:text-white hover:bg-paper-hover transition-colors focus-visible:ring-2 focus-visible:ring-accent"
        aria-label="Tutup jendela informasi"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Modal Content (Dynamic via JS) -->
    <div id="modal-body" class="p-6 overflow-y-auto space-y-4 text-xs font-body text-ink-2">
      <!-- Injected by script -->
    </div>

    <!-- Modal Footer -->
    <div class="p-4 border-t border-rule bg-paper-2 flex items-center justify-between">
      <button 
        id="modal-action-map-btn" 
        class="px-4 py-2.5 rounded-xl bg-paper border border-rule hover:border-accent hover:text-accent text-xs font-semibold text-ink-2 transition-colors flex items-center gap-2 focus-visible:ring-2 focus-visible:ring-accent"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon></svg>
        <span>Tampilkan di Peta</span>
      </button>
      <button 
        id="modal-close-action-btn" 
        class="px-5 py-2.5 rounded-xl bg-accent text-white hover:bg-accent/90 text-xs font-semibold tracking-wide transition-all shadow-sm focus-visible:ring-2 focus-visible:ring-accent"
      >
        Tutup
      </button>
    </div>
  </div>
</div>
