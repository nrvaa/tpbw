---
---

<!-- Detail SPPG. Isi dibangun peta.astro (openSPPGModal); animasi buka/tutup di map-panel.css (.dm-*). -->
<div
  id="detail-modal"
  class="dm fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-describedby="modal-body"
>
  <div class="dm-card relative w-full max-w-2xl bg-paper-card border border-rule-strong rounded-t-3xl sm:rounded-3xl overflow-hidden flex flex-col max-h-[94dvh] sm:max-h-[90vh]">
    <!-- Kepala: warna mengikuti status verifikasi (--dm-tone diisi skrip) -->
    <div class="dm-head relative px-5 pt-5 pb-4 sm:px-7 sm:pt-6 flex items-start justify-between gap-4">
      <div class="min-w-0" data-dm-item>
        <p id="modal-eyebrow" class="text-xs text-ink-muted">Detail SPPG</p>
        <h3 id="modal-title" class="mt-1 font-display text-2xl sm:text-[2rem] leading-[1.1] text-white text-balance">Nama Unit</h3>
        <span id="modal-status" class="dm-status mt-3"></span>
      </div>
      <button
        id="modal-close-btn"
        type="button"
        class="shrink-0 grid place-items-center w-11 h-11 rounded-full bg-paper/60 border border-white/12 text-ink-muted hover:text-white hover:bg-paper-hover hover:rotate-90 transition-[color,background-color,transform] duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        aria-label="Tutup detail"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <div id="modal-body" class="dm-body px-5 pb-5 sm:px-7 sm:pb-6 overflow-y-auto space-y-4 text-xs text-ink-2">
      <!-- Diisi skrip -->
    </div>

    <div class="px-5 py-3 sm:px-7 sm:py-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] border-t border-rule bg-paper-2 flex items-center justify-between gap-2">
      <button
        id="modal-action-map-btn"
        type="button"
        class="flex-1 sm:flex-none justify-center min-h-11 px-4 rounded-xl bg-paper border border-rule hover:border-accent hover:text-accent text-xs font-semibold text-ink-2 transition-colors inline-flex items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"/></svg>
        <span><span class="sm:hidden">Di peta</span><span class="hidden sm:inline">Fokuskan di peta</span></span>
      </button>
      <a
        id="modal-gmaps-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="dm-cta flex-1 sm:flex-none justify-center min-h-11 px-5 rounded-xl inline-flex items-center gap-2 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <span class="sm:hidden">Google Maps</span><span class="hidden sm:inline">Buka di Google Maps</span>
        <svg class="dm-cta-arrow w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8"/></svg>
      </a>
    </div>
  </div>
</div>
