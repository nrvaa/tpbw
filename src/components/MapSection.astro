---
import { sppgList } from '../data/sppg';
import { incidentsEnabled } from '../data/incidents';
import { wilayahCounts, statusCounts, statusInfo, shortWilayah } from '../data/summary';
---

<div id="section-map" style="view-transition-name: peta" class="relative w-full h-full bg-paper" role="region" aria-label="Peta sebaran titik kandidat SPPG">
  <div id="leaflet-map" class="w-full h-full z-10" role="application" aria-label="Peta interaktif titik kandidat SPPG. Pilih penanda untuk melihat informasinya."></div>

  <!-- Status peta: tampil saat Leaflet belum siap, atau bila gagal dimuat -->
  <div id="map-status" class="absolute inset-0 z-30 grid place-items-center bg-paper text-center p-6" role="status" aria-live="polite">
    <div class="space-y-3 max-w-xs">
      <p id="map-status-text" class="text-sm text-ink-2">Memuat peta…</p>
      <button id="map-status-retry" type="button" class="btn-split hidden">Muat ulang halaman</button>
    </div>
  </div>

  <!-- Pemberitahuan ubin gagal (peta tetap bisa dipakai, penanda tetap tampil) -->
  <p id="map-tile-warning" class="hidden absolute bottom-20 left-1/2 -translate-x-1/2 z-20 max-w-[calc(100%-2rem)] px-3 py-2 rounded-lg bg-paper-2 border border-rule-strong text-xs text-ink-2 text-center shadow-xl" role="status">
    Sebagian peta gagal dimuat. Coba peta dasar lain.
  </p>

  <!-- Peta dasar: pengaturan tampilan, jadi ditaruh di peta (kanan atas), bukan di panel filter -->
  <div class="map-tile-picker glass absolute z-20">
    <label for="map-select-tile" class="sr-only">Pilih peta dasar</label>
    <select id="map-select-tile" data-dropdown="Peta dasar" aria-label="Pilih peta dasar">
      <option value="osm" data-icon="map" selected>OpenStreetMap</option>
      <option value="satellite" data-icon="globe">Satelit</option>
      <option value="dark" data-icon="moon">Gelap</option>
    </select>
  </div>

  <!-- Legenda: kecil di kanan bawah, di atas atribusi -->
  <div class="absolute z-20 right-2 bottom-12 sm:bottom-7 px-3 py-2 rounded-lg bg-paper-2/95 border border-rule shadow-xl" role="note" aria-label="Arti warna penanda">
    <p class="text-[11px] text-ink-muted mb-1">Warna = status verifikasi data</p>
    <ul class="flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-ink-2">
      {statusCounts.map(([s]) => (
        <li class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm" style={`background: ${statusInfo(s).marker}`} aria-hidden="true"></span>{statusInfo(s).label}</li>
      ))}
    </ul>
  </div>

  <!-- Panel kontrol di samping peta. Di layar kecil terlipat secara bawaan agar peta tetap terlihat. -->
  <aside id="map-panel" class="map-panel absolute z-20 top-2 left-2 right-2 sm:right-auto sm:w-85 lg:top-3 lg:left-3 flex flex-col glass" aria-label="Pencarian, filter, dan daftar titik">
    <div class="flex items-center gap-2 p-2 pl-3">
      <a href="/" class="flex items-center gap-2.5 min-w-0 flex-1 min-h-11 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" aria-label="SIGMA-B: kembali ke beranda">
        <img src="/img/SIGMA-B — Simbol koordinat.svg" alt="" class="w-8 h-8 shrink-0" width="32" height="32" />
        <span class="min-w-0">
          <h1 class="font-display text-lg leading-tight text-white truncate" style="view-transition-name: brand">SIGMA-B</h1>
          <span id="active-marker-count" class="block text-[11px] text-ink-muted tabular-nums truncate">{sppgList.length} titik SPPG</span>
        </span>
      </a>
      <button
        id="map-panel-toggle"
        type="button"
        aria-controls="map-panel-body"
        aria-expanded="false"
        class="shrink-0 inline-flex items-center gap-1.5 min-h-11 px-3 rounded-lg border border-white/12 bg-paper/45 text-xs font-semibold text-ink-2 hover:border-rule-strong hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <svg class="w-4 h-4 transition-transform map-panel-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
        <span id="map-panel-toggle-label">Cari &amp; filter</span>
      </button>
    </div>

    <div id="map-panel-body" class="map-panel-body flex-col min-h-0 border-t border-rule">
      <div class="p-3 space-y-3">
        <div class="search-wrap relative">
          <label for="map-search-input" class="sr-only">Cari titik SPPG berdasarkan nama, kecamatan, atau alamat</label>
          <input
            type="search"
            id="map-search-input"
            autocomplete="off"
            aria-controls="map-point-list"
            placeholder="Cari nama, kecamatan, alamat"
            class="search-field w-full min-h-11 text-sm pl-9 pr-3 py-2.5"
          />
          <svg class="w-4 h-4 text-ink-muted absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>

        <div class="map-panel-filters" role="group" aria-label="Filter peta">
          <label for="map-select-wilayah" class="sr-only">Filter wilayah</label>
          <select id="map-select-wilayah" data-dropdown="Wilayah" aria-label="Filter wilayah">
            <option value="all" data-icon="list">Semua wilayah</option>
            {wilayahCounts.map(([w, n]) => <option value={w} data-icon="pin">{shortWilayah(w)} ({n})</option>)}
          </select>

          <label for="map-select-status" class="sr-only">Filter status verifikasi data</label>
          <select id="map-select-status" data-dropdown="Status verifikasi" aria-label="Filter status verifikasi data">
            <option value="all" data-icon="list">Semua status</option>
            {statusCounts.map(([s, n]) => <option value={s} data-dot={statusInfo(s).marker}>{statusInfo(s).label} ({n})</option>)}
          </select>

          {incidentsEnabled && (
            <>
              <label for="map-select-incident" class="sr-only">Filter laporan kejadian</label>
              <select id="map-select-incident" data-dropdown="Laporan kejadian" aria-label="Filter laporan kejadian">
                <option value="all">Semua titik SPPG</option>
                <option value="has-incident">Ada laporan kejadian</option>
                <option value="Keracunan">Hanya keracunan</option>
                <option value="Keluhan">Hanya keluhan</option>
                <option value="Gangguan Distribusi">Hanya kendala distribusi</option>
              </select>
            </>
          )}
        </div>
      </div>

      <div class="flex items-baseline justify-between gap-2 px-3 pb-2 border-b border-rule">
        <h2 class="text-xs font-semibold text-ink-2">Daftar titik</h2>
        <button id="map-filter-reset" type="button" class="hidden text-xs text-accent underline underline-offset-2 min-h-11 -my-3 px-1 hover:text-ink focus-visible:outline-2 focus-visible:outline-accent rounded">Hapus filter</button>
      </div>

      <div class="map-panel-list min-h-0 overflow-y-auto overscroll-contain">
        <ul id="map-point-list" class="divide-y divide-rule" aria-label="Titik SPPG sesuai filter"></ul>
        <div id="map-list-empty" class="hidden p-4 text-center space-y-2">
          <p class="text-xs text-ink-2">Tidak ada titik yang cocok.</p>
          <button id="map-empty-reset" type="button" class="btn-split text-xs">Hapus filter</button>
        </div>
        <div id="map-list-more" class="hidden p-3 text-center">
          <button id="map-list-more-btn" type="button" class="min-h-11 px-4 rounded-lg border border-white/12 bg-paper/45 text-xs font-semibold text-ink-2 hover:border-rule-strong hover:text-ink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"></button>
        </div>
      </div>
    </div>
  </aside>
</div>
