---
import { summary, wilayahCounts, shortWilayah } from '../data/summary';

const { totalKandidat, totalWilayah, totalKecamatan, belumDiverifikasi, perluReview, terverifikasi } = summary;
const pct = (n: number) => (totalKandidat ? ((n / totalKandidat) * 100).toFixed(1) : '0');

// Ikon outline yang sama dengan ikon lain di proyek: pin = lokasi, centang = terverifikasi,
// segitiga = perlu dicek, jam = menunggu verifikasi.
const ICON = {
  pin: ['M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z', 'M15 11a3 3 0 11-6 0 3 3 0 016 0z'],
  check: ['M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'],
  alert: ['M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z'],
  clock: ['M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'],
};

const cards = [
  { tone: 'total', target: 'map', title: 'Total Sebaran', meta: `${totalWilayah} kab/kota`, value: totalKandidat, desc: `Titik kandidat di ${totalKecamatan} kecamatan`, icon: ICON.pin,
    label: `Buka peta geospasial: ${totalKandidat} titik kandidat SPPG di ${totalWilayah} kabupaten/kota` },
  { tone: 'verified', target: 'analytics', title: 'Terverifikasi', meta: `${pct(terverifikasi)}%`, value: terverifikasi, desc: 'Koordinat tervalidasi', icon: ICON.check,
    label: `Buka analitik: ${terverifikasi} data terverifikasi (${pct(terverifikasi)}%)` },
  { tone: 'review', target: 'analytics', title: 'Perlu Review', meta: `${pct(perluReview)}%`, value: perluReview, desc: 'Perlu verifikasi lapangan', icon: ICON.alert,
    label: `Buka analitik: ${perluReview} data perlu review (${pct(perluReview)}%)` },
  { tone: 'pending', target: 'directory', title: 'Belum Verifikasi', meta: `${pct(belumDiverifikasi)}%`, value: belumDiverifikasi, desc: 'Data mentah pilot', icon: ICON.clock,
    label: `Buka direktori: ${belumDiverifikasi} data belum diverifikasi (${pct(belumDiverifikasi)}%)` },
];
---

<div class="space-y-3.5" role="region" aria-label="Ringkasan metrik utama kandidat SPPG Bandung Raya">
  <div class="grid grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-4">
    {cards.map((c, i) => (
      <div data-reveal style={`--i:${i + 1}`}>
      <div class="stat-card" data-tone={c.tone} role="button" tabindex="0" data-stat-target={c.target} aria-label={c.label}>
        <div class="stat-card-image" aria-hidden="true">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            {c.icon.map(d => <path stroke-linecap="round" stroke-linejoin="round" d={d} />)}
          </svg>
        </div>
        <div class="stat-card-content">
          <div class="stat-card-top">
            <span class="stat-card-title">{c.title}</span>
            <span class="stat-card-meta tabular-nums">{c.meta}</span>
          </div>
          <div class="stat-card-bottom">
            <span class="stat-card-value tabular-nums">{c.value}</span>
            <span class="stat-card-desc">{c.desc}</span>
          </div>
        </div>
      </div>
      </div>
    ))}
  </div>

  <!-- Telemetry Strip: Validation Ratio & Wilayah Breakdown -->
  <div class="p-4 rounded-xl bg-paper-card border border-rule flex flex-col xl:flex-row xl:items-center justify-between gap-3 text-xs">
    
    <!-- Left: Status Progress Ratio -->
    <div class="space-y-1.5 xl:max-w-sm w-full">
      <div class="flex items-center justify-between text-xs">
        <span class="text-ink-2 font-medium">Komposisi Verifikasi</span>
        <span class="text-ink-dim font-mono text-[11px] tabular-nums text-right">{terverifikasi} valid · {perluReview} review · {belumDiverifikasi} belum</span>
      </div>
      <div class="w-full bg-paper rounded-sm h-1.5 overflow-hidden flex gap-0.5" role="progressbar" aria-label={`Rasio validasi data: ${pct(terverifikasi)}% terverifikasi, ${pct(perluReview)}% perlu review, ${pct(belumDiverifikasi)}% belum diverifikasi`}>
        <div class="bg-emerald-500 h-full transition-all" style={`width: ${pct(terverifikasi)}%`} title={`Terverifikasi: ${terverifikasi} (${pct(terverifikasi)}%)`}></div>
        <div class="bg-amber-400 h-full transition-all" style={`width: ${pct(perluReview)}%`} title={`Perlu Review: ${perluReview} (${pct(perluReview)}%)`}></div>
        <div class="bg-slate-500 h-full transition-all" style={`width: ${pct(belumDiverifikasi)}%`} title={`Belum Diverifikasi: ${belumDiverifikasi} (${pct(belumDiverifikasi)}%)`}></div>
      </div>
    </div>

    <!-- Right: Quick Wilayah Breakdown -->
    <div class="flex flex-wrap items-center gap-1.5 xl:justify-end text-xs font-mono border-t xl:border-t-0 border-rule/60 pt-2.5 xl:pt-0">
      <span class="text-ink-dim font-sans text-xs mr-1">Sebaran:</span>
      {wilayahCounts.map(([w, n]) => (
        <span class="inline-flex items-center gap-1.5 text-ink-2 bg-paper px-2 py-0.5 rounded-md border border-rule/70">
          <span>{shortWilayah(w)}</span>
          <strong class="text-white tabular-nums">{n}</strong>
        </span>
      ))}
    </div>

  </div>
</div>
