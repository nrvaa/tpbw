---
import { sppgList } from '../data/sppg';
import { summary, wilayahCounts, kecamatanCounts, shortWilayah, wilayahColor, STATUS_VALIDASI } from '../data/summary';

const { totalKandidat, totalWilayah, totalKecamatan, belumDiverifikasi, perluReview, terverifikasi } = summary;
const pct = (n: number) => (totalKandidat ? (n / totalKandidat) * 100 : 0);
const topKecamatan = kecamatanCounts.slice(0, 4);
const statusBars = [
  { key: 'terverifikasi', n: terverifikasi },
  { key: 'perlu_review', n: perluReview },
  { key: 'belum_diverifikasi', n: belumDiverifikasi },
] as const;
---

<div class="space-y-4" role="region" aria-label="Ringkasan dataset kandidat SPPG Bandung Raya">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

    <!-- Total kandidat terpetakan -->
    <div
      class="lg:col-span-7 p-6 rounded-2xl bg-paper-card border border-rule hover:border-accent/50 transition-all duration-200 relative overflow-hidden shadow-sm group cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
      role="button"
      tabindex="0"
      data-stat-target="map"
      aria-label={`Buka peta: ${totalKandidat} titik kandidat SPPG terpetakan di ${totalWilayah} kabupaten/kota`}
    >
      <div class="absolute -right-12 -top-12 w-48 h-48 rounded-full bg-accent/5 pointer-events-none group-hover:bg-accent/10 transition-colors" aria-hidden="true"></div>

      <div class="flex items-center justify-between gap-3 mb-4">
        <div class="flex items-center gap-2 font-mono text-[11px] text-ink-muted">
          <span class="w-2 h-2 rounded-full bg-accent" aria-hidden="true"></span>
          <span class="font-semibold text-accent tracking-wider uppercase">Sebaran Kandidat</span>
          <span class="text-ink-dim hidden sm:inline">•</span>
          <span class="text-ink-dim hidden sm:inline">Dataset Pilot</span>
        </div>
        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-accent/10 border border-accent/25 text-accent font-mono text-[11px] font-semibold">
          <span>{totalWilayah} Kab/Kota</span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 mb-4">
        <div>
          <div class="flex items-baseline gap-2.5">
            <span class="text-4xl sm:text-5xl font-display font-extrabold text-white tracking-tight tabular-nums">{totalKandidat}</span>
            <span class="text-sm sm:text-base font-semibold text-ink-2 font-display">Titik</span>
          </div>
          <p class="text-xs text-ink-muted mt-1">Titik kandidat SPPG terpetakan, belum dikonfirmasi sebagai SPPG resmi beroperasi</p>
        </div>
        <div class="sm:text-right font-mono text-xs text-ink-muted border-t sm:border-t-0 sm:border-l border-rule/70 pt-2 sm:pt-0 sm:pl-4">
          <div class="text-[11px] text-ink-dim">Terverifikasi</div>
          <div class="text-sm font-bold text-white tabular-nums">{terverifikasi} / {totalKandidat}</div>
          <div class="text-[11px] text-amber-400 font-medium">{perluReview} perlu review</div>
        </div>
      </div>

      <!-- Komposisi status verifikasi -->
      <div class="space-y-1.5 mb-4">
        <div class="flex justify-between items-center text-[11px] font-mono text-ink-muted">
          <span>Status verifikasi data</span>
          <span class="text-ink-2">{belumDiverifikasi} belum · {perluReview} review · {terverifikasi} terverifikasi</span>
        </div>
        <div class="w-full bg-paper rounded-full h-2.5 p-0.5 border border-rule overflow-hidden flex gap-0.5" role="img" aria-label={`${terverifikasi} terverifikasi, ${perluReview} perlu review, ${belumDiverifikasi} belum diverifikasi`}>
          {statusBars.filter(b => b.n > 0).map(b => (
            <div class={`h-full rounded-full ${STATUS_VALIDASI[b.key].dot}`} style={`width: ${pct(b.n)}%`}></div>
          ))}
        </div>
      </div>

      <div class="pt-3 border-t border-rule/70 flex flex-wrap items-center justify-between gap-2 text-xs">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-mono text-ink-muted">
          <span class="text-ink-dim font-medium">Per wilayah:</span>
          {wilayahCounts.map(([w, n]) => (
            <span class="inline-flex items-center gap-1.5 text-ink-2">
              <span class={`w-1.5 h-1.5 rounded-full ${wilayahColor(w).dot}`} aria-hidden="true"></span>
              <span>{shortWilayah(w)}: <strong class="text-white">{n}</strong></span>
            </span>
          ))}
        </div>
        <span class="text-[11px] font-mono text-accent font-semibold group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1 ml-auto">Lihat Peta</span>
      </div>
    </div>

    <!-- Cakupan administratif -->
    <div
      class="lg:col-span-5 p-6 rounded-2xl bg-paper-card border border-rule hover:border-emerald-500/50 transition-all duration-200 relative overflow-hidden shadow-sm group cursor-pointer focus-visible:ring-2 focus-visible:ring-emerald-400 flex flex-col justify-between"
      role="button"
      tabindex="0"
      data-stat-target="directory"
      aria-label={`Buka direktori: kandidat tersebar di ${totalWilayah} kabupaten/kota dan ${totalKecamatan} kecamatan`}
    >
      <div class="absolute -right-12 -bottom-12 w-44 h-44 rounded-full bg-emerald-500/5 pointer-events-none group-hover:bg-emerald-500/10 transition-colors" aria-hidden="true"></div>

      <div>
        <div class="flex items-center justify-between gap-3 mb-4">
          <div class="flex items-center gap-2 font-mono text-[11px] text-ink-muted">
            <span class="w-2 h-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
            <span class="font-semibold text-emerald-400 tracking-wider uppercase">Cakupan Wilayah</span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 pb-4 border-b border-rule/70">
          <div>
            <span class="text-xs font-semibold text-ink-muted uppercase tracking-wider font-mono block mb-1">Kab/Kota</span>
            <div class="flex items-baseline gap-1.5">
              <span class="text-3xl sm:text-4xl font-display font-extrabold text-white tracking-tight tabular-nums">{totalWilayah}</span>
              <span class="text-xs font-mono text-ink-muted">wilayah</span>
            </div>
          </div>
          <div class="border-l border-rule/70 pl-4">
            <span class="text-xs font-semibold text-ink-muted uppercase tracking-wider font-mono block mb-1">Kecamatan</span>
            <div class="flex items-baseline gap-1.5">
              <span class="text-3xl sm:text-4xl font-display font-extrabold text-white tracking-tight tabular-nums">{totalKecamatan}</span>
              <span class="text-xs font-mono text-ink-muted">kecamatan</span>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-4 text-xs">
        <span class="text-[11px] font-mono text-ink-dim block mb-1.5">Kecamatan dengan titik terbanyak</span>
        <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono">
          {topKecamatan.map(([k, n]) => (
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-lg bg-paper text-ink-2 border border-rule">
              {k} <strong class="text-white">{n}</strong>
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Catatan asal data -->
  <div class="p-4 sm:p-5 rounded-2xl bg-paper-card border border-amber-500/25 shadow-sm" role="note" aria-label="Catatan asal dan batasan data">
    <div class="flex items-start gap-3.5">
      <div class="w-10 h-10 rounded-xl bg-amber-500/15 text-amber-400 flex items-center justify-center border border-amber-500/25 shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <div class="text-xs text-ink-2 space-y-1">
        <p class="font-mono text-[11px] font-bold text-amber-400 tracking-wider uppercase">Batasan Data</p>
        <p>
          {sppgList.length} titik berasal dari eksperimen ekstraksi Google Maps (pilot) dan masih berstatus kandidat.
          Data belum diverifikasi oleh BGN atau pengelola SPPG. Status operasional, kapasitas, jumlah penerima, dan data kejadian belum tersedia sehingga tidak ditampilkan.
        </p>
      </div>
    </div>
  </div>
</div>
