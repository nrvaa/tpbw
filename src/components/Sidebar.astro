---
interface Props {
  activeSection?: string;
}

const { activeSection = "overview" } = Astro.props;
---

<aside id="app-sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-paper-2/95 backdrop-blur-xl border-r border-rule flex flex-col transition-transform duration-300 -translate-x-full lg:translate-x-0 shadow-2xl lg:shadow-none">
  <!-- Brand Header -->
  <div class="h-20 px-6 flex items-center gap-3.5 border-b border-rule">
    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center text-white shadow-lg shadow-emerald-500/20 ring-1 ring-white/20">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
    </div>
    <div class="flex flex-col">
      <div class="flex items-center gap-1.5">
        <span class="font-display font-extrabold tracking-tight text-white text-base leading-none">SPPG BANDUNG</span>
      </div>
      <span class="text-[11px] font-mono tracking-wider text-emerald-400 font-semibold uppercase mt-1">GIS & MONITORING MBG</span>
    </div>
  </div>

  <!-- Quick Status Banner -->
  <div class="px-5 py-4 border-b border-rule bg-paper-3/40">
    <div class="flex items-center justify-between text-xs text-ink-2 mb-1.5">
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Status Jaringan
      </span>
      <span class="font-mono text-emerald-400 font-semibold text-[11px]">27 SPPG</span>
    </div>
    <div class="w-full bg-paper rounded-full h-1.5 overflow-hidden ring-1 ring-rule">
      <div class="bg-gradient-to-r from-emerald-500 to-accent h-full w-[88%] rounded-full"></div>
    </div>
    <div class="flex justify-between items-center text-[10px] text-ink-muted mt-1 font-mono">
      <span>Bandung Raya Terpetakan</span>
      <span>88.9% Aktif</span>
    </div>
  </div>

  <!-- Navigation Menu -->
  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto" aria-label="Navigasi Halaman Utama">
    <button data-nav="overview" aria-current="page" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all text-white bg-accent/20 border border-accent/30 focus-visible:ring-2 focus-visible:ring-accent active:scale-[0.98] group">
      <svg class="w-4 h-4 text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
        <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
        <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
        <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
      </svg>
      <span>Dashboard Overview</span>
      <span class="ml-auto text-[10px] font-mono bg-paper-2 px-1.5 py-0.5 rounded text-ink-muted border border-rule">Live</span>
    </button>

    <button data-nav="map" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all text-ink-2 hover:text-white hover:bg-paper-hover focus-visible:ring-2 focus-visible:ring-accent active:scale-[0.98] group">
      <svg class="w-4 h-4 text-ink-muted group-hover:text-emerald-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
        <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
        <line x1="8" y1="2" x2="8" y2="18"></line>
        <line x1="16" y1="6" x2="16" y2="22"></line>
      </svg>
      <span>Peta Geospasial</span>
      <span class="ml-auto w-2 h-2 rounded-full bg-emerald-500" aria-label="Tersedia"></span>
    </button>

    <button data-nav="incidents" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all text-ink-2 hover:text-white hover:bg-paper-hover focus-visible:ring-2 focus-visible:ring-accent active:scale-[0.98] group">
      <svg class="w-4 h-4 text-ink-muted group-hover:text-rose-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
      <span>Data Kejadian</span>
      <span class="ml-auto text-[10px] font-mono bg-rose-500/15 text-rose-300 font-semibold px-2 py-0.5 rounded-full border border-rose-500/25">20 Isu</span>
    </button>

    <button data-nav="directory" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all text-ink-2 hover:text-white hover:bg-paper-hover focus-visible:ring-2 focus-visible:ring-accent active:scale-[0.98] group">
      <svg class="w-4 h-4 text-ink-muted group-hover:text-blue-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
      <span>Direktori SPPG</span>
      <span class="ml-auto text-[10px] font-mono text-ink-muted">27 Unit</span>
    </button>

    <button data-nav="analytics" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all text-ink-2 hover:text-white hover:bg-paper-hover focus-visible:ring-2 focus-visible:ring-accent active:scale-[0.98] group">
      <svg class="w-4 h-4 text-ink-muted group-hover:text-purple-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
      </svg>
      <span>Analitik & Tren</span>
    </button>
  </nav>

  <!-- Wilayah Filter Chips In Sidebar -->
  <div class="p-4 border-t border-rule bg-paper-3/20" role="region" aria-label="Filter Wilayah Cepat">
    <div class="flex items-center justify-between mb-2">
      <p class="text-[10px] font-mono uppercase tracking-wider text-ink-muted font-bold">Fokus Wilayah</p>
      <span class="text-[10px] font-mono text-ink-dim">Filter Cepat</span>
    </div>
    <div class="flex flex-wrap gap-1.5" id="sidebar-region-pills" role="toolbar" aria-label="Pilihan Wilayah">
      <button aria-pressed="true" class="region-pill-btn active text-[11px] px-2.5 py-1 rounded-lg bg-accent/20 text-accent font-semibold border border-accent/35 transition-all hover:bg-accent/30 focus-visible:ring-2 focus-visible:ring-accent" data-wilayah="all">Semua</button>
      <button aria-pressed="false" class="region-pill-btn text-[11px] px-2.5 py-1 rounded-lg bg-paper text-ink-muted hover:text-ink hover:bg-paper-hover border border-rule transition-all focus-visible:ring-2 focus-visible:ring-accent" data-wilayah="Kota Bandung">Kota Bdg</button>
      <button aria-pressed="false" class="region-pill-btn text-[11px] px-2.5 py-1 rounded-lg bg-paper text-ink-muted hover:text-ink hover:bg-paper-hover border border-rule transition-all focus-visible:ring-2 focus-visible:ring-accent" data-wilayah="Kabupaten Bandung">Kab. Bdg</button>
      <button aria-pressed="false" class="region-pill-btn text-[11px] px-2.5 py-1 rounded-lg bg-paper text-ink-muted hover:text-ink hover:bg-paper-hover border border-rule transition-all focus-visible:ring-2 focus-visible:ring-accent" data-wilayah="Kota Cimahi">Cimahi</button>
      <button aria-pressed="false" class="region-pill-btn text-[11px] px-2.5 py-1 rounded-lg bg-paper text-ink-muted hover:text-ink hover:bg-paper-hover border border-rule transition-all focus-visible:ring-2 focus-visible:ring-accent" data-wilayah="Kabupaten Bandung Barat">KBB</button>
      <button aria-pressed="false" class="region-pill-btn text-[11px] px-2.5 py-1 rounded-lg bg-paper text-ink-muted hover:text-ink hover:bg-paper-hover border border-rule transition-all focus-visible:ring-2 focus-visible:ring-accent" data-wilayah="Kabupaten Sumedang">Sumedang</button>
    </div>
  </div>

  <!-- Footer Credits -->
  <div class="p-4 border-t border-rule flex items-center justify-between text-xs text-ink-muted bg-paper-2">
    <div>
      <p class="font-medium text-ink">Kelompok 14</p>
      <p class="text-[11px] text-ink-muted">Tugas Besar Pemrograman Web</p>
    </div>
    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">2025</span>
  </div>
</aside>

<!-- Backdrop for mobile -->
<div id="sidebar-backdrop" class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm hidden lg:hidden"></div>
