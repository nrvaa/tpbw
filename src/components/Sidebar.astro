---
import { summary, wilayahCounts, shortWilayah, STATUS_VALIDASI } from '../data/summary';
import { incidentsEnabled } from '../data/incidents';

const maxWilayah = wilayahCounts[0]?.[1] ?? 1;
const statusRows = [
  { ...STATUS_VALIDASI.belum_diverifikasi, n: summary.belumDiverifikasi },
  { ...STATUS_VALIDASI.perlu_review, n: summary.perluReview },
  { ...STATUS_VALIDASI.terverifikasi, n: summary.terverifikasi },
];

// Ikon outline yang sama gayanya dengan ikon lain di dashboard.
const NAV = [
  { key: 'overview', href: '#section-overview', label: 'Ringkasan', d: 'M4 13h6V4H4v9zm0 7h6v-5H4v5zm10 0h6v-9h-6v9zm0-16v5h6V4h-6z' },
  { key: 'map', href: '#map-wrapper', label: 'Peta sebaran', d: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7' },
  { key: 'analytics', href: '#analytics-wrapper', label: 'Analitik wilayah', d: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6m6 0h6m-6 0V9a2 2 0 012-2h2a2 2 0 012 2v10m0 0h6m-6 0V5a2 2 0 012-2h2a2 2 0 012 2v14' },
  ...(incidentsEnabled ? [{ key: 'incidents', href: '#incidents-wrapper', label: 'Data kejadian', d: 'M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z' }] : []),
  { key: 'directory', href: '#directory-wrapper', label: 'Direktori', count: summary.totalKandidat, d: 'M4 6h16M4 12h16M4 18h10' },
];
---

<aside id="default-sidebar" class="sb fixed top-0 left-0 z-40 w-64 h-screen transition-transform -translate-x-full lg:translate-x-0" aria-label="Navigasi dashboard">
  <div class="sb-inner">

    <a href="/" class="sb-brand" aria-label="SIGMA-B: kembali ke halaman utama">
      <img src="/img/SIGMA-B — Simbol koordinat.svg" alt="Simbol koordinat SIGMA-B" class="sb-mark" width="36" height="36" />
      <span class="min-w-0">
        <span class="sb-brand-name" style="view-transition-name: brand">SIGMA-B</span>
        <span class="sb-brand-sub">Peta kandidat · data pilot</span>
      </span>
    </a>

    <nav class="sb-block" aria-label="Bagian dashboard">
      <p class="sb-label">Bagian</p>
      <ul class="sb-nav">
        {NAV.map(item => (
          <li>
            <a href={item.href} data-nav={item.key} class="nav-btn sb-link" aria-current={item.key === 'overview' ? 'page' : undefined}>
              <svg class="sb-icon" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.d} />
              </svg>
              <span class="flex-1">{item.label}</span>
              {item.count && <span class="sb-count">{item.count}</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="sb-block" role="group" aria-labelledby="sb-wilayah-label">
      <p class="sb-label" id="sb-wilayah-label">Filter wilayah</p>
      <div class="sb-regions" id="sidebar-region-pills">
        <button type="button" class="region-pill-btn sb-region" data-wilayah="all" aria-pressed="true">
          <span class="sb-region-row"><span>Semua wilayah</span><strong>{summary.totalKandidat}</strong></span>
        </button>
        {wilayahCounts.map(([w, n]) => (
          <button type="button" class="region-pill-btn sb-region" data-wilayah={w} aria-pressed="false">
            <span class="sb-region-row"><span>{shortWilayah(w)}</span><strong>{n}</strong></span>
            <span class="sb-bar" aria-hidden="true"><span style={`width: ${(n / maxWilayah) * 100}%`}></span></span>
          </button>
        ))}
      </div>
    </div>

    <div class="sb-block">
      <p class="sb-label">Warna penanda</p>
      <ul class="sb-legend">
        {statusRows.map(s => (
          <li><span class="sb-dot" style={`--dot: ${s.marker}`} aria-hidden="true"></span><span class="flex-1">{s.label}</span><span class="sb-count">{s.n}</span></li>
        ))}
      </ul>
    </div>

    <div class="sb-foot">
      <a href="/" class="sb-home">
        <svg class="sb-icon" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7M3 12h18" /></svg>
        Beranda
      </a>
    </div>
  </div>
</aside>

<div id="sidebar-backdrop" class="fixed inset-0 z-30 bg-black/60 hidden lg:hidden"></div>

<script>
  function setupSidebar() {
    const sidebar = document.getElementById('default-sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const toggles = document.querySelectorAll('[data-drawer-toggle="default-sidebar"]');

    // Sama dengan breakpoint lg: di bawahnya sidebar jadi drawer.
    const drawerMode = window.matchMedia('(max-width: 1023px)');

    const setDrawer = (open: boolean) => {
      if (!sidebar) return;
      sidebar.classList.toggle('-translate-x-full', !open);
      backdrop?.classList.toggle('hidden', !open);
      // Drawer tertutup ada di luar layar; inert supaya link-nya tidak ikut urutan Tab.
      sidebar.inert = drawerMode.matches && !open;
      toggles.forEach(btn => btn.setAttribute('aria-expanded', String(open)));
    };
    setDrawer(false);
    drawerMode.addEventListener('change', () => setDrawer(false));

    toggles.forEach(btn => btn.addEventListener('click', e => {
      e.stopPropagation();
      setDrawer(!!sidebar?.classList.contains('-translate-x-full'));
    }));
    backdrop?.addEventListener('click', () => setDrawer(false));
    document.querySelectorAll('#default-sidebar a[href^="#"], #default-sidebar .sb-region').forEach(el =>
      el.addEventListener('click', () => { if (drawerMode.matches) setDrawer(false); }));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') setDrawer(false); });

    // Penanda bagian aktif mengikuti posisi scroll (bukan hanya saat diklik).
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.sb-link')];
    const ids = links.map(a => a.getAttribute('href')!.slice(1));
    const setCurrent = (id: string) => links.forEach(a => {
      if (a.getAttribute('href') === `#${id}`) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => {
        const hit = entries.filter(e => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (hit) setCurrent(hit.target.id);
      }, { rootMargin: '-35% 0px -55% 0px' });
      ids.forEach(id => { const el = document.getElementById(id); if (el) io.observe(el); });
    }
  }

  setupSidebar();
</script>
