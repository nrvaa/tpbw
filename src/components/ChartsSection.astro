---
import { sppgList, incidentList } from '../data/sppg';

// Aggregations
const wilayahCounts: Record<string, number> = {};
sppgList.forEach(s => {
  wilayahCounts[s.wilayah] = (wilayahCounts[s.wilayah] || 0) + 1;
});

const incidentCounts: Record<string, number> = {
  "Keracunan": 0,
  "Keluhan": 0,
  "Gangguan Distribusi": 0
};
incidentList.forEach(i => {
  incidentCounts[i.jenis] = (incidentCounts[i.jenis] || 0) + 1;
});
---

<div id="section-analytics" class="grid grid-cols-1 lg:grid-cols-3 gap-5" role="region" aria-label="Analitik Wilayah dan Grafik Tren Kejadian">
  <!-- Chart 1: Distribusi SPPG per Wilayah Bandung Raya -->
  <div class="bento-card card-spotlight lg:col-span-2 p-5 rounded-2xl bg-paper-card border border-rule flex flex-col shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-blue-500/15 text-blue-400 flex items-center justify-center border border-blue-500/25">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-display font-bold text-white">Distribusi Unit SPPG & Kapasitas</h3>
          <p class="text-xs text-ink-muted">Sebaran dapur pemenuhan gizi antar kab/kota se-Bandung Raya</p>
        </div>
      </div>
      <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-paper text-ink-2 border border-rule">5 Wilayah</span>
    </div>
    <div class="relative flex-1 min-h-[260px] w-full">
      <canvas id="chart-wilayah" role="img" aria-label="Grafik batang sebaran jumlah SPPG dan estimasi porsi penerima harian di 5 wilayah Bandung Raya"></canvas>
    </div>
  </div>

  <!-- Chart 2: Komposisi Jenis Insiden -->
  <div class="bento-card card-spotlight p-5 rounded-2xl bg-paper-card border border-rule flex flex-col shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-rose-500/15 text-rose-400 flex items-center justify-center border border-rose-500/25">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-display font-bold text-white">Rasio Jenis Kejadian</h3>
          <p class="text-xs text-ink-muted">Proporsi keracunan vs logistik</p>
        </div>
      </div>
      <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-rose-500/15 text-rose-300 border border-rose-500/25">20 Kasus</span>
    </div>
    <div class="relative flex-1 min-h-[220px] flex items-center justify-center">
      <canvas id="chart-incident-ratio" role="img" aria-label="Grafik donat persentase jenis insiden: 6 keracunan, 7 keluhan, 7 gangguan distribusi"></canvas>
    </div>
    <div class="mt-4 pt-3 border-t border-rule grid grid-cols-3 gap-2 text-center text-[11px] font-mono">
      <div>
        <span class="text-rose-400 font-bold block text-sm">{incidentCounts['Keracunan']}</span>
        <span class="text-ink-muted text-[10px]">Keracunan</span>
      </div>
      <div>
        <span class="text-amber-400 font-bold block text-sm">{incidentCounts['Keluhan']}</span>
        <span class="text-ink-muted text-[10px]">Keluhan</span>
      </div>
      <div>
        <span class="text-blue-400 font-bold block text-sm">{incidentCounts['Gangguan Distribusi']}</span>
        <span class="text-ink-muted text-[10px]">Distribusi</span>
      </div>
    </div>
  </div>

  <!-- Chart 3: Tren Kejadian Bulanan Sepanjang 2025 -->
  <div class="bento-card card-spotlight lg:col-span-3 p-5 rounded-2xl bg-paper-card border border-rule shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-emerald-500/15 text-emerald-400 flex items-center justify-center border border-emerald-500/25">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-display font-bold text-white">Tren Waktu Insiden & Kejadian MBG (Tahun 2025)</h3>
          <p class="text-xs text-ink-muted">Fluktuasi laporan insiden bulanan untuk deteksi dini musim rawan</p>
        </div>
      </div>
      <div class="flex items-center gap-3 text-xs font-mono">
        <span class="flex items-center gap-1.5 text-rose-300 font-medium">
          <span class="w-2 h-2 rounded-full bg-rose-500" aria-hidden="true"></span> Keracunan
        </span>
        <span class="flex items-center gap-1.5 text-amber-300 font-medium">
          <span class="w-2 h-2 rounded-full bg-amber-500" aria-hidden="true"></span> Keluhan
        </span>
        <span class="flex items-center gap-1.5 text-blue-300 font-medium">
          <span class="w-2 h-2 rounded-full bg-blue-500" aria-hidden="true"></span> Logistik
        </span>
      </div>
    </div>
    <div class="relative min-h-[200px] w-full">
      <canvas id="chart-monthly-trends" role="img" aria-label="Grafik garis fluktuasi waktu kejadian bulanan sepanjang 2025"></canvas>
    </div>
  </div>
</div>
