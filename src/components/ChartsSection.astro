---
import { incidentList, incidentsEnabled } from '../data/incidents';
import { summary, wilayahCounts, statusCounts, statusInfo } from '../data/summary';

const incidentCounts: Record<string, number> = { "Keracunan": 0, "Keluhan": 0, "Gangguan Distribusi": 0 };
incidentList.forEach(i => { incidentCounts[i.jenis] = (incidentCounts[i.jenis] || 0) + 1; });
---

<div id="section-analytics" class="grid grid-cols-1 xl:grid-cols-3 gap-4" role="region" aria-label="Analitik sebaran kandidat SPPG per wilayah">
  <!-- Chart 1: Jumlah titik kandidat per kab/kota -->
  <div class="xl:col-span-2 p-4 sm:p-5 rounded-xl bg-paper-card border border-rule flex flex-col justify-between shadow-xs">
    <div class="flex items-start justify-between gap-3 mb-4">
      <div>
        <h3 class="text-sm font-semibold text-white">Titik Kandidat per Kab/Kota</h3>
        <p class="text-xs text-ink-muted">Distribusi frekuensi lokasi kandidat SPPG di tiap wilayah</p>
      </div>
      <span class="text-xs font-mono px-2 py-0.5 rounded bg-paper text-ink-2 border border-rule/80 tabular-nums shrink-0 whitespace-nowrap">{summary.totalWilayah} Wilayah</span>
    </div>
    <div class="relative h-[280px] sm:h-[300px] xl:h-auto xl:flex-1 xl:min-h-[260px] w-full">
      <canvas id="chart-wilayah" role="img" aria-label={`Grafik batang jumlah titik kandidat SPPG per kab/kota: ${wilayahCounts.map(([w, n]) => `${w} ${n}`).join(', ')}`}></canvas>
    </div>
  </div>

  <!-- Chart 2: Komposisi status verifikasi -->
  <div class="p-4 sm:p-5 rounded-xl bg-paper-card border border-rule flex flex-col justify-between shadow-xs">
    <div class="flex items-start justify-between gap-3 mb-4">
      <div>
        <h3 class="text-sm font-semibold text-white">Status Verifikasi Data</h3>
        <p class="text-xs text-ink-muted">Tingkat kelengkapan atribut pada dataset pilot</p>
      </div>
      <span class="text-xs font-mono px-2 py-0.5 rounded bg-paper text-ink-2 border border-rule/80 tabular-nums shrink-0 whitespace-nowrap">{summary.totalKandidat} Titik</span>
    </div>
    <div class="relative h-[240px] w-full max-w-[320px] mx-auto">
      <canvas id="chart-status-validasi" role="img" aria-label={`Grafik donat status verifikasi: ${statusCounts.map(([s, n]) => `${statusInfo(s).label} ${n}`).join(', ')}`}></canvas>
    </div>
    <div class="mt-4 pt-3 border-t border-rule/70 grid grid-cols-3 gap-2 text-center text-xs font-mono">
      <div>
        <span class="text-slate-400 font-bold block text-sm tabular-nums">{summary.belumDiverifikasi}</span>
        <span class="text-ink-muted text-[11px]">Belum</span>
      </div>
      <div>
        <span class="text-amber-400 font-bold block text-sm tabular-nums">{summary.perluReview}</span>
        <span class="text-ink-muted text-[11px]">Review</span>
      </div>
      <div>
        <span class="text-emerald-400 font-bold block text-sm tabular-nums">{summary.terverifikasi}</span>
        <span class="text-ink-muted text-[11px]">Terverifikasi</span>
      </div>
    </div>
  </div>

  <!-- Grafik kejadian (jika aktif) -->
  {incidentsEnabled && (
    <div class="xl:col-span-3 p-4 sm:p-5 rounded-xl bg-paper-card border border-rule shadow-xs">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-sm font-semibold text-white">Rasio Jenis Kejadian</h3>
          <p class="text-xs text-ink-muted">Dari {incidentList.length} laporan terverifikasi</p>
        </div>
      </div>
      <div class="relative min-h-[220px] w-full">
        <canvas id="chart-incident-ratio" role="img" aria-label={`Grafik donat jenis kejadian: ${incidentCounts['Keracunan']} keracunan, ${incidentCounts['Keluhan']} keluhan, ${incidentCounts['Gangguan Distribusi']} gangguan distribusi`}></canvas>
      </div>
    </div>
  )}
</div>
