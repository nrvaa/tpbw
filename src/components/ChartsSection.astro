---
import { incidentList, incidentsEnabled } from '../data/incidents';
import { summary, wilayahCounts, statusCounts, statusInfo } from '../data/summary';

const incidentCounts: Record<string, number> = { "Keracunan": 0, "Keluhan": 0, "Gangguan Distribusi": 0 };
incidentList.forEach(i => { incidentCounts[i.jenis] = (incidentCounts[i.jenis] || 0) + 1; });
---

<div id="section-analytics" class="grid grid-cols-1 lg:grid-cols-3 gap-5" role="region" aria-label="Analitik sebaran kandidat SPPG per wilayah">
  <!-- Chart 1: Jumlah titik kandidat per kab/kota -->
  <div class="bento-card card-spotlight lg:col-span-2 p-5 rounded-2xl bg-paper-card border border-rule flex flex-col shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-blue-500/15 text-blue-400 flex items-center justify-center border border-blue-500/25">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-display font-bold text-white">Titik Kandidat per Kab/Kota</h3>
          <p class="text-xs text-ink-muted">Jumlah titik dan status verifikasinya di tiap wilayah</p>
        </div>
      </div>
      <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-paper text-ink-2 border border-rule">{summary.totalWilayah} Wilayah</span>
    </div>
    <div class="relative flex-1 min-h-[260px] w-full">
      <canvas id="chart-wilayah" role="img" aria-label={`Grafik batang jumlah titik kandidat SPPG per kab/kota: ${wilayahCounts.map(([w, n]) => `${w} ${n}`).join(', ')}`}></canvas>
    </div>
  </div>

  <!-- Chart 2: Komposisi status verifikasi -->
  <div class="bento-card card-spotlight p-5 rounded-2xl bg-paper-card border border-rule flex flex-col shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-amber-500/15 text-amber-400 flex items-center justify-center border border-amber-500/25">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-display font-bold text-white">Status Verifikasi Data</h3>
          <p class="text-xs text-ink-muted">Bukan status operasional dapur</p>
        </div>
      </div>
      <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-paper text-ink-2 border border-rule">{summary.totalKandidat} Titik</span>
    </div>
    <div class="relative flex-1 min-h-[220px] flex items-center justify-center">
      <canvas id="chart-status-validasi" role="img" aria-label={`Grafik donat status verifikasi: ${statusCounts.map(([s, n]) => `${statusInfo(s).label} ${n}`).join(', ')}`}></canvas>
    </div>
    <div class="mt-4 pt-3 border-t border-rule grid grid-cols-3 gap-2 text-center text-[11px] font-mono">
      <div>
        <span class="text-blue-400 font-bold block text-sm">{summary.belumDiverifikasi}</span>
        <span class="text-ink-muted text-[10px]">Belum</span>
      </div>
      <div>
        <span class="text-amber-400 font-bold block text-sm">{summary.perluReview}</span>
        <span class="text-ink-muted text-[10px]">Perlu review</span>
      </div>
      <div>
        <span class="text-emerald-400 font-bold block text-sm">{summary.terverifikasi}</span>
        <span class="text-ink-muted text-[10px]">Terverifikasi</span>
      </div>
    </div>
  </div>

  <!-- Grafik kejadian: hanya dirender bila dataset kejadian terverifikasi tersedia -->
  {incidentsEnabled && (
    <div class="bento-card card-spotlight lg:col-span-3 p-5 rounded-2xl bg-paper-card border border-rule shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-sm font-display font-bold text-white">Rasio Jenis Kejadian</h3>
          <p class="text-xs text-ink-muted">Dari {incidentList.length} laporan terverifikasi</p>
        </div>
      </div>
      <div class="relative min-h-[220px] w-full">
        <canvas id="chart-incident-ratio" role="img" aria-label={`Grafik donat jenis kejadian: ${incidentCounts['Keracunan']} keracunan, ${incidentCounts['Keluhan']} keluhan, ${incidentCounts['Gangguan Distribusi']} gangguan distribusi`}></canvas>
      </div>
    </div>
  )}
</div>
